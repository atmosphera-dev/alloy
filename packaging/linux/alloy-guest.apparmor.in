# Substitute the three exact absolute installed paths and unique profile names.
# The app creates the outer enclosure; the entries create Chromium's inner
# userns sandbox. This is not a filesystem/IPC
# policy and never grants a setuid-helper route to guest mode.
abi <abi/4.0>,
include <tunables/global>

profile @@PROFILE@@-app @@APP@@ flags=(unconfined) {
  userns,
}

profile @@PROFILE@@-bootstrap @@BOOTSTRAP@@ flags=(unconfined) {
  userns,
}

profile @@PROFILE@@-engine @@ENGINE@@ flags=(unconfined) {
  userns,
}
