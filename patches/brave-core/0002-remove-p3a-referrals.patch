-template <std::size_t N>
-void ReportMetric(const char* histogram_name,
-                  const int (&buckets)[N],
-                  size_t count,
-                  bool suppress_when_zero) {
-  if (suppress_when_zero && count == 0) {
-    base::UmaHistogramExactLinear(histogram_name, INT_MAX - 1,
-                                  std::size(buckets) + 1);
-    return;
-  }
