-  VLOG(2) << "StarRandomnessMeta: starting attestation";
-  GURL attestation_url = GURL(
-      base::StrCat({config_->star_randomness_host, "/enclave/attestation"}));
-  if (!attestation_url.is_valid() || !attestation_url.SchemeIsHTTPOrHTTPS()) {
