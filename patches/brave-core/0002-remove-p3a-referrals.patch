-#if !BUILDFLAG(IS_IOS)
-  base::ScopedObservation<misc_metrics::DefaultBrowserMonitor,
-                          misc_metrics::DefaultBrowserMonitor::Observer>
-      default_browser_observation_{this};
-#endif  // !BUILDFLAG(IS_IOS)
-};
