- protected:
-  std::vector<uint8_t> FromBase64(const char* b64_string) {
-    return *base::Base64Decode(b64_string);
-  }
-  std::vector<uint8_t> FromHex(const char* hex_string) {
-    std::vector<uint8_t> bytes;
-    base::HexStringToBytes(hex_string, &bytes);
-    return bytes;
-  }
-};
