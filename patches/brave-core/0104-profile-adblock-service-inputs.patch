+void AdBlockService::OnProfileClosing() {
+  auto failed = close_failed_;
+  if (!Close(base::DoNothing())) failed.Run();
+}
+
+bool AdBlockService::Close(base::OnceClosure done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!closed_) {
+    closed_ = true;
+    weak_factory_.InvalidateWeakPtrs();
+    pref_change_registrar_.reset();
+    default_service_observer_.reset();
+    additional_filters_service_observer_.reset();
+    subscription_service_manager_.reset();
+    component_service_manager_.reset();
+    localhost_filters_provider_.reset();
+    custom_filters_provider_.reset();
+    default_filters_provider_.reset();
+    default_exception_filters_provider_.reset();
+    filter_list_catalog_provider_.reset();
+    default_resource_provider_ = nullptr;
+    custom_resource_provider_ = nullptr;
+    resource_provider_.reset();
+    filters_provider_manager_.reset();
+    dat_cache_manager_.reset();
+    engine_wrapper_.Reset();
+  }
+  // Reset posts destruction. This original FIFO fence acknowledges only after
+  // both native engines and their accepted tasks have actually retired.
+  return task_runner_->PostTaskAndReply(FROM_HERE, base::DoNothing(), std::move(done));
+}
