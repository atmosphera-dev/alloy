+AdBlockEngineWrapper::PreparedLoad::~PreparedLoad()=default;
+std::unique_ptr<AdBlockEngineWrapper::PreparedLoad> AdBlockEngineWrapper::PrepareLoad(
+    bool which,std::unique_ptr<rust::Box<adblock::FilterSet>> filters,
+    AdblockResourceStorageBox resources,bool serialize,std::optional<DATFileDataBuffer> cached) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto prepared=std::unique_ptr<PreparedLoad>(new PreparedLoad);
+  prepared->resources=std::move(resources);
+  prepared->resources_only=!filters&&!cached;
+  if(prepared->resources_only){prepared->loaded=true;return prepared;}
+  prepared->engine=std::make_unique<AdBlockEngine>(which);
+  if(discard_policy_)prepared->engine->SetupDiscardPolicy(*discard_policy_);
+  prepared->loaded=cached ? prepared->engine->Load(true,*cached,**prepared->resources)
+      : prepared->engine->Load(std::move(*filters),**prepared->resources);
+  if(prepared->loaded&&serialize&&!cached)prepared->dat=prepared->engine->Serialize();
+  return prepared;
+}
+AdBlockEngineWrapper::LoadResult AdBlockEngineWrapper::PublishLoad(bool which,
+    std::unique_ptr<PreparedLoad> prepared,const std::shared_ptr<AdBlockLoadEpoch>& epoch) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(prepared&&epoch);
+  LoadResult result;result.loaded=prepared->loaded;result.resources_only=prepared->resources_only;
+  result.current=epoch->Publish([&] {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if(!prepared->loaded)return;
+    if(prepared->resources_only)result.loaded=Load(which,nullptr,std::move(*prepared->resources));
+    else if(which)default_engine_=std::move(prepared->engine);
+    else additional_filters_engine_=std::move(prepared->engine);
+  });
+  if(result.current&&result.loaded)result.dat=std::move(prepared->dat);
+  return result;
+}
+
