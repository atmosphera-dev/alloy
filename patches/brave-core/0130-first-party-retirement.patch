+
+void TransportSecurityState::RememberAlloyHost(std::string_view host) {
+  const GURL url(base::StrCat({"https://", host}));
+  const auto domain = AlloyRecordDomainForPrincipal(url, url::Origin::Create(url));
+  const auto canonical = CanonicalizeHost(host);
+  if (!domain.empty() && !canonical.empty())
+    alloy_record_hosts_[domain].insert(HashHost(canonical));
+}
+
+void TransportSecurityState::RetireAlloyRecord(const std::string& domain) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  bool changed = false;
+  auto hosts = alloy_record_hosts_.extract(domain);
+  if (!hosts.empty()) for (const auto& hash : hosts.mapped())
+    changed = enabled_sts_hosts_.DeleteDataInAllPartitions(hash) || changed;
+  const auto canonical = CanonicalizeHost(domain);
+  if (!canonical.empty()) {
+    const auto hash = HashHost(canonical);
+    changed = enabled_sts_hosts_.DeleteDataInAllPartitions(hash) || changed;
+    changed = enabled_sts_hosts_.DeletePartition(hash) || changed;
+  }
+  if (changed) DirtyNotify();
 }
 
