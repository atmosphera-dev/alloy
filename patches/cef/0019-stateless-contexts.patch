+CefRefPtr<CefRequestContext> AlloyCreateStatelessRequestContext(
+    alloy_network_state_t network_state,
+    CefRefPtr<CefRequestContextHandler> handler) {
+  CEF_API_REQUIRE_ADDED(CEF_EXPERIMENTAL);
+  switch (network_state) {
+    case ALLOY_NETWORK_STATE_KEEP:
+      return CefRequestContextImpl::CreateStateless(
+          alloy::site_records::NetworkState::kKeep, handler);
+    case ALLOY_NETWORK_STATE_CUT:
+      return CefRequestContextImpl::CreateStateless(
+          alloy::site_records::NetworkState::kCut, handler);
+  }
+  return nullptr;
+}
+
 // CefRequestContextImpl
+
+// static
+CefRefPtr<CefRequestContext> CefRequestContextImpl::CreateStateless(
+    alloy::site_records::NetworkState network_state,
+    CefRefPtr<CefRequestContextHandler> handler) {
+  if (!CONTEXT_STATE_VALID()) {
+    return nullptr;
+  }
+  Config config;
+  config.stateless_network_state = network_state;
+  config.settings.cookieable_schemes_exclude_defaults = true;
+  config.handler = handler;
+  config.unique_id = g_next_id.GetNext();
+  return GetOrCreateRequestContext(std::move(config));
+}
 
