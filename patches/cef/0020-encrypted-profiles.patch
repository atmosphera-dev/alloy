+///
+/// EXPERIMENTAL: Encrypted profile lifecycle state. TRANSITION does not
+/// acknowledge that keys have been wiped; ERROR requires explicit lock/reopen.
+///
+typedef enum {
+  ALLOY_PROFILE_LOCKED = 0,
+  ALLOY_PROFILE_UNLOCKED = 1,
+  ALLOY_PROFILE_TRANSITION = 2,
+  ALLOY_PROFILE_ERROR = 3,
+} alloy_profile_state_t;
+
+///
+/// EXPERIMENTAL: Secret Service result. MISSING includes a missing default
+/// collection or profile entry. FAILED includes protocol/integrity/I/O errors.
+///
+typedef enum {
+  ALLOY_KEYRING_OK = 0,
+  ALLOY_KEYRING_UNAVAILABLE = 1,
+  ALLOY_KEYRING_LOCKED = 2,
+  ALLOY_KEYRING_MISSING = 3,
+  ALLOY_KEYRING_FAILED = 4,
+} alloy_keyring_result_t;
