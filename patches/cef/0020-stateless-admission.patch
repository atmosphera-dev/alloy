+ChromeContentBrowserClientCef::GetGeneratedCodeCacheSettings(
+    content::BrowserContext* context) {
+  if (const auto* policy = alloy::site_records::RequestContextPolicy::Get(*context);
+      policy && !policy->StorageCapability(alloy::site_records::StorePurpose::kCodeCache)
+                     .Allows(alloy::site_records::StorePurpose::kCodeCache,
+                             alloy::site_records::StorageAccess::kWriteMemory)) {
+    return content::GeneratedCodeCacheSettings(false, 0, base::FilePath());
+  }
+
+  return BraveContentBrowserClient::GetGeneratedCodeCacheSettings(context);
+}
