+content::AllowServiceWorkerResult ChromeContentBrowserClientCef::AllowServiceWorker(
+    const GURL& scope, const net::SiteForCookies& site_for_cookies,
+    const std::optional<url::Origin>& top_frame_origin,
+    const blink::StorageKey& storage_key, const GURL& script_url,
+    content::BrowserContext* context) {
+  if (const auto* policy = alloy::site_records::RequestContextPolicy::Get(*context);
+      policy && !policy->StorageCapability(alloy::site_records::StorePurpose::kServiceWorkers)
+                     .Allows(alloy::site_records::StorePurpose::kServiceWorkers,
+                             alloy::site_records::StorageAccess::kWriteMemory)) {
+    return content::AllowServiceWorkerResult::No();
+  }
+
+  return BraveContentBrowserClient::AllowServiceWorker(scope, site_for_cookies,
+      top_frame_origin, storage_key, script_url, context);
+}
+
+bool ChromeContentBrowserClientCef::AllowSharedWorker(
+    const GURL& worker_url, const net::SiteForCookies& site_for_cookies,
+    const std::optional<url::Origin>& top_frame_origin, const std::string& name,
+    const blink::StorageKey& storage_key,
+    blink::mojom::SharedWorkerSameSiteCookies same_site_cookies,
+    content::BrowserContext* context, int render_process_id, int render_frame_id) {
+  if (const auto* policy = alloy::site_records::RequestContextPolicy::Get(*context);
+      policy && !policy->StorageCapability(alloy::site_records::StorePurpose::kBackgroundJobs)
+                     .Allows(alloy::site_records::StorePurpose::kBackgroundJobs,
+                             alloy::site_records::StorageAccess::kWriteMemory)) {
+    return false;
+  }
+
+  return BraveContentBrowserClient::AllowSharedWorker(worker_url, site_for_cookies,
+      top_frame_origin, name, storage_key, same_site_cookies, context,
+      render_process_id, render_frame_id);
+}
+
