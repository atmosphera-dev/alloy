+// Native profiles outlive browser close notifications and the call stack that
+// destroys WebContents. The existing ProfileDestroyer then owns renderer-host
+// retirement. No timer/poll, second context registry or retained plaintext owner.
+class EncryptedProfileRetirement final : public CefBrowserHostBase::Observer {
+ public:
+  static void Begin(std::unique_ptr<Profile> profile) {
+    auto* retirement = new EncryptedProfileRetirement(std::move(profile));
+    std::vector<CefRefPtr<CefBrowserHostBase>> browsers;
+    for (const auto& info : CefBrowserInfoManager::GetInstance()->GetBrowserInfoList()) {
+      auto browser = info->browser();
+      if (browser && browser->GetBrowserContext() == retirement->profile_.get()) {
+        retirement->pending_.insert(browser.get());
+        browser->AddObserver(retirement);
+        browsers.push_back(browser);
+      }
+    }
+    if (browsers.empty()) { retirement->Finish(); return; }
+    for (const auto& browser : browsers) browser->CloseBrowser(true);
+  }
+  void OnBrowserDestroyed(CefBrowserHostBase* browser) override {
+    browser->RemoveObserver(this);
+    pending_.erase(browser);
+    if (pending_.empty()) Finish();
+  }
+ private:
+  explicit EncryptedProfileRetirement(std::unique_ptr<Profile> profile)
+      : profile_(std::move(profile)) {}
+  void Finish() {
+    CEF_POST_TASK(CEF_UIT, base::BindOnce(
+        &ProfileDestroyer::DestroyOriginalProfileWhenAppropriate, std::move(profile_)));
+    delete this;
+  }
+  std::unique_ptr<Profile> profile_;
+  std::set<CefBrowserHostBase*> pending_;
+};
 }  // namespace
 
