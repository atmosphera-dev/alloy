+// static
+CefRefPtr<CefRequestContext> CefRequestContextImpl::CreateEncrypted(
+    std::unique_ptr<alloy::site_records::NativeProfileConfiguration> configuration,
+    CefRefPtr<CefRequestContextHandler> handler) {
+  CEF_REQUIRE_UIT();
+  if (!CONTEXT_STATE_VALID() || !configuration) return nullptr;
+  Config config;
+  config.context_mode = alloy::site_records::ContextMode::Encrypted();
+  config.handler = handler;
+  config.unique_id = g_next_id.GetNext();
+  for (auto* existing : CefBrowserContext::GetAll()) {
+    auto* native = existing->AsBrowserContext();
+    auto* input = native ? alloy::site_records::NativeProfileConfiguration::Get(*native) : nullptr;
+    if (input && input->admitted() && input->SharesOwnerWith(*configuration)) {
+      config.browser_context = existing;
+      return GetOrCreateRequestContext(std::move(config));
+    }
+  }
+  if (!configuration->BeginConstruction()) return nullptr;
+  config.native_configuration = std::move(configuration);
+  return GetOrCreateRequestContext(std::move(config));
+}
+
+bool AlloyCreateEncryptedRequestContext(CefRefPtr<AlloyProfile> profile,
+    CefRefPtr<CefRequestContextHandler> handler, CefRefPtr<AlloyRequestContextCallback> callback) {
+  CEF_API_REQUIRE_ADDED(CEF_EXPERIMENTAL);
+  if (!CONTEXT_STATE_VALID() || !CEF_CURRENTLY_ON_UIT() || !profile || !callback) return false;
+  alloy::PrepareNativeProfileConfiguration(profile, base::BindOnce(
+      [](CefRefPtr<CefRequestContextHandler> handler, CefRefPtr<AlloyRequestContextCallback> callback,
+         alloy_site_settings_result_t result,
+         std::unique_ptr<alloy::site_records::NativeProfileConfiguration> configuration) {
+        if (result != ALLOY_SETTINGS_OK) { callback->OnComplete(result, nullptr); return; }
+        auto context = CefRequestContextImpl::CreateEncrypted(std::move(configuration), handler);
+        if (!context) { callback->OnComplete(ALLOY_SETTINGS_CANCELLED, nullptr); return; }
+        auto* impl = static_cast<CefRequestContextImpl*>(context.get());
+        impl->ExecuteWhenBrowserContextInitialized(base::BindOnce(
+            [](CefRefPtr<CefRequestContext> context, CefRefPtr<AlloyRequestContextCallback> callback) {
+              auto* impl = static_cast<CefRequestContextImpl*>(context.get());
+              const bool admitted = impl->VerifyBrowserContext();
+              callback->OnComplete(admitted ? ALLOY_SETTINGS_OK : ALLOY_SETTINGS_CANCELLED,
+                                   admitted ? context : nullptr);
+            }, context, callback));
+      }, handler, callback));
+  return true;
+}
