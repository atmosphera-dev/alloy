+void ChromeBrowserContext::InitializeEncryptedProfile() {
+  pending_configuration_->SetTeardownHandler(base::BindOnce(
+      &ChromeBrowserContext::RetireEncryptedProfile, weak_ptr_factory_.GetWeakPtr()));
+  // This opaque native identity is not a filesystem backing or catalogue key.
+  // The explicit configuration suppresses path intake before Profile allocation.
+  auto identity = g_browser_process->profile_manager()->user_data_dir().AppendASCII(
+      "AlloyEncrypted-"+base::UnguessableToken::Create().ToString());
+  owned_profile_ = Profile::CreateProfile(identity, this, Profile::CreateMode::kSynchronous,
+                                         std::move(pending_configuration_));
+  if (owned_profile_ && encrypted_creation_succeeded_) {
+    auto* configuration = alloy::site_records::NativeProfileConfiguration::Get(*profile_);
+    CHECK(configuration);
+    if (configuration->admitted()) browser_prefs::SetInitialProfilePrefs(profile_);
+    configuration->ConstructionFinished();
+  } else {
+    RetireEncryptedProfile();
+  }
+  // Unwind native construction and the existing CEF factory's assignment before
+  // delivering creation or a cancelled original-generation result.
+  CEF_POST_TASK(CEF_UIT, base::BindOnce(&ChromeBrowserContext::CompleteEncryptedInitialization,
+                                      weak_ptr_factory_.GetWeakPtr()));
+}
+void ChromeBrowserContext::CompleteEncryptedInitialization() {
+  initialization_finished_ = true;
+  auto callbacks = std::move(init_callbacks_);
+  for (auto& callback : callbacks) std::move(callback).Run();
+}
+void ChromeBrowserContext::RetireEncryptedProfile() {
+  revoked_ = true;
+  InvalidateContextGetters();
+  if (owned_profile_) EncryptedProfileRetirement::Begin(std::move(owned_profile_));
+}
