+bool CefBrowserHostBase::NotifyBrowserCreated() {
+  CEF_REQUIRE_UIT_RETURN(false);
+  CefRefPtr<CefBrowserHostBase> keep_alive(this);
+  if (!platform_delegate_ || !IsValid()) {
+    return false;
+  }
+  {
+    // Preserve the creation-time navigation boundary in both runtime styles.
+    // The client may synchronously close this browser, including from tasks
+    // released when the navigation lock unwinds.
+    auto navigation_lock = browser_info_->CreateNavigationLock();
+    OnAfterCreated();
+  }
+  if (!platform_delegate_ || !IsValid()) {
+    return false;
+  }
+  platform_delegate_->NotifyBrowserCreated();
+  return platform_delegate_ && IsValid();
+}
