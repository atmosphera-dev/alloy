+bool CefRequestContextImpl::SetAlloyEmbeddedStateScope(const CefString& scope) {
+  if (!CEF_CURRENTLY_ON_UIT() || !browser_context() ||
+      !browser_context()->IsInitialized()) {
+    return false;
+  }
+  const std::string value = scope;
+  using Scope = alloy::site_records::EmbeddedStateScope;
+  Scope selected;
+  if (value == "per-outer-site") {
+    selected = Scope::kPerOuterSite;
+  } else if (value == "per-tab") {
+    selected = Scope::kPerTab;
+  } else {
+    return false;
+  }
+  auto* native = browser_context()->AsBrowserContext();
+  return native && content::ConfigureAlloyEmbeddedStateScope(*native, selected);
+}
