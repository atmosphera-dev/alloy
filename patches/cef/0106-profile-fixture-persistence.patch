+///
+/// Flushes setup persistence for an ordinary test-control browser. Returns
+/// false for an invalid/off-the-record browser, null callback or non-UI call.
+/// Otherwise callback runs on UI only after native profile preferences and
+/// NetworkContext persistent-state completion. Does not clear data. For fixture
+/// setup only.
+///
+/*--cef(added=experimental)--*/
+bool CefFlushBrowserPersistentStateForTests(
+    CefRefPtr<CefBrowser> browser,
+    CefRefPtr<CefCompletionCallback> callback);
