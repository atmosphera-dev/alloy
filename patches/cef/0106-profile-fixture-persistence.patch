+bool CefFlushBrowserPersistentStateForTests(
+    CefRefPtr<CefBrowser> browser,
+    CefRefPtr<CefCompletionCallback> callback) {
+  CEF_API_REQUIRE_ADDED(CEF_EXPERIMENTAL);
+  CEF_REQUIRE_UIT_RETURN(false);
+  auto host = CefBrowserHostBase::FromBrowser(browser);
+  if (!host || !callback) {
+    return false;
+  }
+  auto* context = host->GetBrowserContext();
+  auto* profile = context ? Profile::FromBrowserContext(context) : nullptr;
+  if (!profile || profile->IsOffTheRecord()) {
+    return false;
+  }
+  auto done = base::BarrierClosure(
+      2, base::BindOnce(
+             [](CefRefPtr<CefBrowser> keep_alive,
+                CefRefPtr<CefCompletionCallback> callback) {
+               callback->OnComplete();
+             },
+             browser, callback));
+  profile->GetPrefs()->CommitPendingWrite(done);
+  context->GetDefaultStoragePartition()
+      ->GetNetworkContext()
+      ->FlushPersistentStateForTesting(done);
+  return true;
+}
