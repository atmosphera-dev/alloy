+namespace {
+content::BrowserContext* CustomFilterContext(
+    CefRefPtr<CefRequestContext> context) {
+  if (!CONTEXT_STATE_VALID() || !CEF_CURRENTLY_ON_UIT() || !context)
+    return nullptr;
+  auto* impl = static_cast<CefRequestContextImpl*>(context.get());
+  if (!impl->VerifyBrowserContext()) return nullptr;
+  auto* cef_context = impl->GetBrowserContext();
+  auto* native = cef_context ? cef_context->AsBrowserContext() : nullptr;
+  const auto* policy = native ? alloy::site_records::RequestContextPolicy::Get(*native) : nullptr;
+  if (!policy || policy->storage_mode() == alloy::site_records::StorageMode::kStateless)
+    return nullptr;
+  return native;
+}
+}  // namespace
+
+bool AlloyGetAdBlockCustomFilters(CefRefPtr<CefRequestContext> context,
+                                CefString& filters) {
+  CEF_API_REQUIRE_ADDED(CEF_EXPERIMENTAL);
+  filters.clear();
+  auto* native = CustomFilterContext(context);
+  if (!native) return false;
+  brave_shields::AdBlockServiceLease original(*native);
+  auto* service = original.Get();
+  if (!service || !service->custom_filters_provider()) return false;
+  const auto value = service->custom_filters_provider()->GetCustomFilters();
+  if (!original.Get()) return false;
+  filters = value;
+  return true;
+}
+
+bool AlloySetAdBlockCustomFilters(CefRefPtr<CefRequestContext> context,
+                                const CefString& filters) {
+  CEF_API_REQUIRE_ADDED(CEF_EXPERIMENTAL);
+  auto* native = CustomFilterContext(context);
+  if (!native) return false;
+  brave_shields::AdBlockServiceLease original(*native);
+  auto* service = original.Get();
+  if (!service || !service->custom_filters_provider()) return false;
+  const bool accepted = service->custom_filters_provider()->UpdateCustomFilters(filters.ToString());
+  return accepted && original.Get();
+}
