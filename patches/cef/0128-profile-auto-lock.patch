+namespace {
+class ProfileLockNavigationThrottle final : public content::NavigationThrottle {
+ public:
+  explicit ProfileLockNavigationThrottle(content::NavigationThrottleRegistry& registry)
+      : NavigationThrottle(registry) {}
+  ThrottleCheckResult CheckAdmission() {
+    return alloy::ProfileNavigationAllowed(*navigation_handle()->GetWebContents()->GetBrowserContext())
+        ? PROCEED : CANCEL_AND_IGNORE;
+  }
+  ThrottleCheckResult WillStartRequest() override { return CheckAdmission(); }
+  ThrottleCheckResult WillRedirectRequest() override { return CheckAdmission(); }
+  ThrottleCheckResult WillProcessResponse() override { return CheckAdmission(); }
+  ThrottleCheckResult WillCommitWithoutUrlLoader() override { return CheckAdmission(); }
+  const char* GetNameForLogging() override { return "AlloyProfileLock"; }
+};
+}  // namespace
+bool ChromeContentBrowserClientCef::CanCommitURL(content::RenderProcessHost* process,
+                                               const GURL& url) {
+  return alloy::ProfileNavigationAllowed(*process->GetBrowserContext()) &&
+      BraveContentBrowserClient::CanCommitURL(process, url);
+}
+
 void ChromeContentBrowserClientCef::CreateThrottlesForNavigation(
     content::NavigationThrottleRegistry& registry) {
+  registry.AddThrottle(std::make_unique<ProfileLockNavigationThrottle>(registry));
   BraveContentBrowserClient::CreateThrottlesForNavigation(registry);
   throttle::CreateThrottlesForNavigation(registry);
