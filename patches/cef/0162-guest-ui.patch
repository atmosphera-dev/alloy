+void CefFrameHostImpl::SendGuestCommand(const std::string& command,
+    base::RepeatingCallback<bool()> extra_admission, base::OnceCallback<void(bool)> completion) {
+  CEF_REQUIRE_UIT();
+  auto* frame = GetRenderFrameHost();
+  auto* integration = content::AlloyGuestIntegration::Get(frame);
+  auto admission = integration ? integration->CaptureAdmission(frame) : base::RepeatingCallback<bool()>();
+  auto done = mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(completion), false);
+  if (!admission || !admission.Run()) { std::move(done).Run(false); return; }
+  const auto document = frame->GetWeakDocumentPtr();
+  SendToRenderFrame(__FUNCTION__, base::BindOnce(
+      [](const std::string& command, content::WeakDocumentPtr document,
+          base::RepeatingCallback<bool()> admission, base::RepeatingCallback<bool()> extra,
+          base::OnceCallback<void(bool)> done, const RenderFrameType& remote) {
+        auto* original = document.AsRenderFrameHostIfValid();
+        if (!original || !admission.Run() || (extra && !extra.Run())) {
+          std::move(done).Run(false); return;
+        }
+        static_cast<content::WebContentsImpl*>(content::WebContents::FromRenderFrameHost(original))
+            ->RecordAlloyGuestUiInteraction(original);
+        remote->SendCommandForDocument(command,
+            static_cast<content::RenderFrameHostImpl*>(original)->GetDocumentToken());
+        std::move(done).Run(true);
+      }, command, document, std::move(admission), std::move(extra_admission), std::move(done)));
 }
 
