+void CefFrameImpl::CaptureGuestEditContext(const blink::DocumentToken& document,
+    const base::UnguessableToken& token, bool context_menu,
+    CaptureGuestEditContextCallback callback) {
+  ExecuteOnLocalFrame(__FUNCTION__, base::BindOnce(
+      [](CefRefPtr<CefFrameImpl> self, blink::DocumentToken document,
+          base::UnguessableToken token, bool context_menu,
+          CaptureGuestEditContextCallback callback, blink::WebLocalFrame* frame) {
+        if (token.is_empty() || frame->GetDocument().Token() != document) {
+          std::move(callback).Run(false); return;
+        }
+        auto element = frame->GetDocument().FocusedElement();
+        if (context_menu) {
+          for (auto node = frame->ContextMenuNode(); !node.IsNull(); node = node.ParentOrShadowHostNode()) {
+            if (!node.IsElementNode()) continue;
+            auto candidate = node.To<blink::WebElement>();
+            if (candidate.IsEditable()) { element = candidate; break; }
+          }
+        }
+        self->guest_edit_context_ = GuestEditContext{token, document, element, frame->SelectionRangeForRestoration()};
+        std::move(callback).Run(true);
+      }, CefRefPtr<CefFrameImpl>(this), document, token, context_menu, std::move(callback)));
+}
+
+void CefFrameImpl::ReleaseGuestEditContext(const base::UnguessableToken& token) {
+  if (guest_edit_context_ && guest_edit_context_->token == token) guest_edit_context_.reset();
+}
