+      !alloy::ProfileNavigationAllowed(*web_contents->GetBrowserContext())) {
+    return std::nullopt;
+  }
+  GURL url = params.url;
+  if (!url_util::FixupGURL(url)) {
+    return std::nullopt;
+  }
+  return url;
