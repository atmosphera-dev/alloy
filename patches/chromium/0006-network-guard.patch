+int NetworkServiceNetworkDelegate::OnBeforeResolveHost(
+    std::string_view host,
+    const net::MutableNetworkTrafficAnnotationTag& originating_annotation,
+    bool* allow_owned_doh_bootstrap) {
+  auto decision = network_context_->alloy_guard().Decide(
+      alloy::kNativeDns.unique_id_hash_code, host,
+      "NetworkServiceNetworkDelegate.OnBeforeResolveHost",
+      AlloyGuard::Operation::kOwnedDns,
+      originating_annotation.unique_id_hash_code);
+  *allow_owned_doh_bootstrap = decision.allowed;
+  return decision.allowed ? net::OK : net::ERR_NETWORK_ACCESS_DENIED;
+}
