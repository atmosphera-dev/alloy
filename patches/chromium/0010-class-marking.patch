+#if BUILDFLAG(ALLOY_ENABLE_CLASS_MARKING)
+int SocketTag::AlloyDscpForAnnotation(int annotation) {
+  if (annotation <= 0) {
+#define ALLOY_TRAFFIC_CLASS(symbol, name, dscp)
+#define ALLOY_NO_CLASS(name, dscp) return dscp;
+#include "net/base/alloy_traffic_classes.inc"
+#undef ALLOY_NO_CLASS
+#undef ALLOY_TRAFFIC_CLASS
+  }
+  switch (ClassifyAlloyAnnotation(annotation)) {
+#define ALLOY_TRAFFIC_CLASS(symbol, name, dscp) \
+  case AlloyTrafficClass::symbol:               \
+    return dscp;
+#define ALLOY_NO_CLASS(name, dscp)
+#include "net/base/alloy_traffic_classes.inc"
+#undef ALLOY_NO_CLASS
+#undef ALLOY_TRAFFIC_CLASS
+  }
+  NOTREACHED();
+}
+
+void SocketTag::ApplyAlloy(SocketDescriptor socket) const {
+  sockaddr_storage address{};
+  socklen_t length = sizeof(address);
+  CHECK_EQ(0,
+           getsockname(socket, reinterpret_cast<sockaddr*>(&address), &length));
+  // Unix-domain sockets have no IP traffic class.
+  if (address.ss_family != AF_INET && address.ss_family != AF_INET6) {
+    return;
+  }
+  auto set = [&](int level, int option) {
+    int value = 0;
+    socklen_t size = sizeof(value);
+    CHECK_EQ(0, getsockopt(socket, level, option, &value, &size));
+    value = (alloy_dscp() << 2) | (value & 3);  // Preserve ECN.
+    CHECK_EQ(0, setsockopt(socket, level, option, &value, sizeof(value)))
+        << "Alloy verification socket class marking failed";
+  };
+  // Set both options for IPv6 sockets: mapped IPv4 destinations use IP_TOS.
+  set(IPPROTO_IP, IP_TOS);
+  if (address.ss_family == AF_INET6) {
+    set(IPPROTO_IPV6, IPV6_TCLASS);
+  }
+}
+#endif
+
