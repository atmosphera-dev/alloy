+// Capture authority from the real creator/ancestor document chain, never the
+// requested script URL. Factories below keep these params browser-only/trusted.
+int AlloyWorkerOwner(RenderFrameHostImpl& ancestor,
+                     const url::Origin& creator_origin) {
+  auto owner_for = [](const url::Origin& origin, const GURL& document_url,
+                      bool browser_document) {
+    const auto& tuple = origin.GetTupleOrPrecursorTupleIfOpaque();
+    const std::string_view scheme =
+        tuple.scheme().empty() ? document_url.scheme() : tuple.scheme();
+    return net::AlloyWorkerOwnerForPrincipal(
+        scheme, browser_document || HasWebUIScheme(tuple.GetURL()) ||
+                    HasWebUIScheme(document_url));
+  };
+  if (const int owner =
+          owner_for(creator_origin, ancestor.GetLastCommittedURL(), false);
+      !net::IsAlloyPageWorkerOwner(owner)) {
+    return owner;
+  }
+  for (auto* frame = &ancestor; frame;
+       frame = frame->GetParentOrOuterDocument()) {
+    auto* contents = WebContentsImpl::FromRenderFrameHostImpl(frame);
+    const bool browser_document =
+        frame->GetWebUI() ||
+        (contents && contents->privileged_params().has_value());
+    const int owner = owner_for(frame->GetLastCommittedOrigin(),
+                                frame->GetLastCommittedURL(), browser_document);
+    if (!net::IsAlloyPageWorkerOwner(owner)) {
+      return owner;
+    }
+  }
+  return net::AlloyAnnotationHash("blink_resource_loader");
+}
 
