+std::unique_ptr<PrefServiceSyncable>
+PrefServiceSyncable::CreateIndependentPrefService(
+    policy::PolicyService* policies, policy::BrowserPolicyConnector* connector,
+    scoped_refptr<PrefStore> command_line_prefs) {
+  CHECK_EQ(policies == nullptr, connector == nullptr);
+  pref_service_forked_ = true;
+  PrefServiceSyncableFactory factory;
+  factory.set_user_prefs(base::MakeRefCounted<InMemoryPrefStore>());
+  factory.SetAccountPrefStore(base::MakeRefCounted<InMemoryPrefStore>());
+  factory.set_command_line_prefs(std::move(command_line_prefs));
+  if (policies) {
+    factory.SetManagedPolicies(policies, connector);
+    factory.SetRecommendedPolicies(policies, connector);
+  }
+  return factory.CreateSyncable(pref_registry_->ForkForIncognito());
+}
+
 bool PrefServiceSyncable::IsSyncing() {
   return pref_sync_associator_.models_associated();
 }
