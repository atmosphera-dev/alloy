+scoped_refptr<AlloyNetworkGeneration>
+StoragePartitionImpl::CreateAlloyNetworkGeneration() {
+  std::erase_if(alloy_network_generations_,
+                [](const auto& value) { return !value; });
+  auto generation = base::MakeRefCounted<AlloyNetworkGeneration>();
+  InitializeAlloyNetworkGeneration(generation.get());
+  alloy_network_generations_.push_back(generation->GetWeakPtr());
+  return generation;
+}
+
+void StoragePartitionImpl::InitializeAlloyNetworkGeneration(
+    AlloyNetworkGeneration* generation) {
+  mojo::Remote<network::mojom::NetworkContext> context;
+  mojo::Remote<cert_verifier::mojom::CertVerifierServiceUpdater> verifier;
+  auto params = BuildNetworkContextParams(&verifier);
+  if (!params) {
+    return;
+  }
+  CreateNetworkContextInNetworkService(context.BindNewPipeAndPassReceiver(),
+                                       std::move(params));
+  std::vector<network::mojom::IdAndAllowlistedPatternsPtr> restrictions;
+  for (const auto& [id, allowlists] : network_restrictions_ids_) {
+    restrictions.push_back(
+        network::mojom::IdAndAllowlistedPatterns::New(id, allowlists));
+  }
+  mojo::PendingRemote<network::mojom::NetworkContextClient> client;
+  const auto receiver =
+      alloy_network_clients_.Add(this, client.InitWithNewPipeAndPassReceiver());
+  auto remove_client = base::BindOnce(
+      [](base::WeakPtr<StoragePartitionImpl> partition,
+         mojo::ReceiverId receiver) {
+        if (partition) {
+          partition->alloy_network_clients_.Remove(receiver);
+        }
+      },
+      weak_factory_.GetWeakPtr(), receiver);
+  auto recreate = base::BindRepeating(
+      [](base::WeakPtr<StoragePartitionImpl> partition,
+         base::WeakPtr<AlloyNetworkGeneration> generation) {
+        if (partition && generation) {
+          partition->InitializeAlloyNetworkGeneration(generation.get());
+        }
+      },
+      weak_factory_.GetWeakPtr(), generation->GetWeakPtr());
+  generation->Bind(context.Unbind(), verifier.Unbind(),
+                   std::move(remove_client), std::move(recreate));
+  // Bind the endpoint to its lifetime owner before sending anything with a
+  // response callback. Unbind() cannot transfer outstanding Mojo callbacks.
+  auto* network_context = generation->GetNetworkContext();
+  network_context->RestrictNetworkForIds(std::move(restrictions),
+                                         base::NullCallback());
+  network_context->SetClient(std::move(client));
+}
+
+void StoragePartitionImpl::ForEachNetworkContext(
+    base::FunctionRef<void(network::mojom::NetworkContext*,
+                           cert_verifier::mojom::CertVerifierServiceUpdater*)>
+        callback) {
+  std::erase_if(alloy_network_generations_,
+                [](const auto& value) { return !value; });
+  std::vector<scoped_refptr<AlloyNetworkGeneration>> leases;
+  for (auto& weak : alloy_network_generations_) {
+    if (weak) {
+      leases.emplace_back(weak.get());
+    }
+  }
+  callback(GetNetworkContext(), GetCertVerifierServiceUpdater());
+  for (auto& lease : leases) {
+    if (auto* context = lease->GetNetworkContext()) {
+      callback(context, lease->GetVerifier());
+    }
+  }
+}
