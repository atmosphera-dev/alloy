+
+std::unique_ptr<NavigationEntryImpl> NavigationEntryImpl::CloneUrlOnly() const {
+  auto entry = std::make_unique<NavigationEntryImpl>();
+  entry->SetURL(GetVirtualURL());
+  entry->set_unique_id(GetUniqueID());
+  // No SiteInstance or document survives. The native restore classification
+  // materializes this URL afresh on traversal, without any restore payload.
+  entry->set_restore_type(RestoreType::kRestored);
+  entry->frame_tree_->frame_entry->SetPageState(
+      blink::PageState::CreateFromURL(GetVirtualURL()));
+  return entry;
+}
+
+void NavigationEntryImpl::DiscardRestorePayload() {
+  std::vector<TreeNode*> nodes{frame_tree_.get()};
+  while (!nodes.empty()) {
+    auto* node = nodes.back();
+    nodes.pop_back();
+    node->frame_entry->DiscardRestorePayload();
+    for (auto& child : node->children) {
+      nodes.push_back(child.get());
+    }
+  }
+  post_data_.reset();
 }
 
