+void ChromePermissionsClient::SetPermissionSettingForDocument(
+    content::BrowserContext* browser_context,
+    const permissions::PermissionRequestData& request,
+    ContentSettingsType type,
+    const PermissionSetting& setting,
+    const content_settings::ContentSettingConstraints& constraints) {
+  if (!alloy::site_records::RequestContextPolicy::IsStateless(
+          *browser_context)) {
+    return PermissionsClient::SetPermissionSettingForDocument(
+        browser_context, request, type, setting, constraints);
+  }
+  auto* frame = request.alloy_document.AsRenderFrameHostIfValid();
+  if (!frame || browser_context->ShutdownStarted()) {
+    return;
+  }
+  auto document_constraints = constraints.Clone();
+  // All decisions end with the document. Keep any shorter native expiry,
+  // without a profile-wide one-time grant tracker or activity timestamps.
+  document_constraints.set_session_model(
+      content_settings::mojom::SessionModel::DURABLE);
+  document_constraints.set_track_last_visit_for_autoexpiration(false);
+  HostContentSettingsMapFactory::GetForFrame(frame)
+      ->SetPermissionSettingDefaultScope(request.requesting_origin,
+                                         request.embedding_origin, type,
+                                         setting, document_constraints);
 }
 
