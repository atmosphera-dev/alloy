+  auto* holder =
+      DocumentPermissionServiceContextHolder::GetOrCreateForCurrentDocument(
+          owner);
+  std::erase_if(holder->worker_contexts, [](const auto& value) {
+    return !value->render_process_host();
+  });
+  for (auto& context : holder->worker_contexts) {
+    if (context->render_process_host() == worker_process) {
+      return context.get();
+    }
+  }
+  holder->worker_contexts.push_back(std::make_unique<PermissionServiceContext>(
+      worker_process, owner->GetWeakDocumentPtr()));
+  return holder->worker_contexts.back().get();
