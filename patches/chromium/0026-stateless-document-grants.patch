+ChromeBluetoothDelegate::AllowWebBluetoothResult
+ChromeBluetoothDelegate::AllowWebBluetoothForDocument(
+    content::BrowserContext* context,
+    content::RenderFrameHost* frame,
+    const url::Origin& requesting,
+    const url::Origin& embedding) {
+  auto result = AllowWebBluetooth(context, requesting, embedding);
+  if (result != AllowWebBluetoothResult::kAllow) {
+    return result;
+  }
+  if (HostContentSettingsMapFactory::GetForFrame(frame)->GetContentSetting(
+          requesting.GetURL(), embedding.GetURL(),
+          ContentSettingsType::BLUETOOTH_GUARD) == CONTENT_SETTING_BLOCK) {
+    return AllowWebBluetoothResult::kBlockPolicy;
+  }
+  return result;
+}
+
+bool ChromeBluetoothDelegate::IsBluetoothScanningBlockedForDocument(
+    content::BrowserContext* context,
+    content::RenderFrameHost* frame,
+    const url::Origin& requesting,
+    const url::Origin& embedding) {
+  return IsBluetoothScanningBlocked(context, requesting, embedding) ||
+         HostContentSettingsMapFactory::GetForFrame(frame)->GetContentSetting(
+             requesting.GetURL(), embedding.GetURL(),
+             ContentSettingsType::BLUETOOTH_SCANNING) == CONTENT_SETTING_BLOCK;
+}
+
+void ChromeBluetoothDelegate::BlockBluetoothScanningForDocument(
+    content::BrowserContext* context,
