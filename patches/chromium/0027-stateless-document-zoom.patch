 void ZoomController::SetZoomModeInternal(ZoomMode new_mode) {
+  if (new_mode == ZOOM_MODE_DEFAULT &&
+      alloy::site_records::RequestContextPolicy::IsStateless(
+          *browser_context_)) {
+    new_mode = ZOOM_MODE_ISOLATED;
+  }
   if (new_mode == zoom_mode_)
     return;
 
