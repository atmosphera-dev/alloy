+HttpsOnlyModeTabHelper::GetState() const {
+  if (!alloy_document_scoped_) {
+    return ordinary_state_.get();
+  }
+  if (!web_contents()) {
+    return nullptr;
+  }
+  auto* owner = content::AlloyStateOwnerForContext(
+      alloy_owner_, web_contents()->GetBrowserContext());
+  if (!owner) {
+    return nullptr;
+  }
+  auto* state =
+      static_cast<NativeNavigationState*>(owner->GetUserData(&kAlloyStateKey));
+  if (!state) {
+    auto created = std::make_unique<NativeNavigationState>();
+    state = created.get();
+    owner->SetUserData(&kAlloyStateKey, std::move(created));
+  }
+  return state;
+}
+
+void HttpsOnlyModeTabHelper::PrepareAlloyReload(
+    const GURL& url,
+    ReloadContinuation continuation) {
+  if (!alloy_document_scoped_) {
+    return;
+  }
+  alloy_owner_ =
+      content::AlloyDocumentStateOwner(web_contents()->GetPrimaryMainFrame());
+  if (auto* state = GetState()) {
+    state->approved_reload_url = url;
+    state->approved_reload_document =
+        web_contents()->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+    state->approved_reload = std::move(continuation);
+  }
+}
+
 void HttpsOnlyModeTabHelper::DidStartNavigation(
     content::NavigationHandle* navigation_handle) {
+  if (alloy_document_scoped_) {
+    if (!navigation_handle->IsInPrimaryMainFrame() ||
+        navigation_handle->IsSameDocument()) {
+      return;
+    }
+    auto* previous_owner = content::AlloyStateOwnerForContext(
+        alloy_owner_, web_contents()->GetBrowserContext());
+    auto* previous = GetState();
+    const bool reload =
+        navigation_handle->GetReloadType() != content::ReloadType::NONE;
+    const bool maintain = previous && previous->is_exempt_error_ && reload;
+    ReloadContinuation approved;
+    if (previous && reload &&
+        previous->approved_reload_url == navigation_handle->GetURL() &&
+        previous->approved_reload_document.AsRenderFrameHostIfValid() ==
+            web_contents()->GetPrimaryMainFrame()) {
+      approved = std::move(previous->approved_reload);
+    }
+    if (previous) {
+      previous->approved_reload.Reset();
+      previous->approved_reload_url = GURL();
+      previous->approved_reload_document = {};
+    }
+    auto next = content::AlloyNavigationStateOwner(navigation_handle);
+    auto* next_owner = content::AlloyStateOwnerForContext(
+        next, web_contents()->GetBrowserContext());
+    if (maintain && previous_owner && next_owner &&
+        previous_owner != next_owner &&
+        !next_owner->GetUserData(&kAlloyStateKey)) {
+      next_owner->SetUserData(&kAlloyStateKey,
+                              previous_owner->TakeUserData(&kAlloyStateKey));
+    }
+    alloy_owner_ = next;
+    if (approved) {
+      std::move(approved).Run(next);
+    }
+  }
