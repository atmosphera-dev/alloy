+void PrefProvider::EnableDocumentPermissionState() {
+  CHECK(off_the_record_);
+  if (document_permission_state_) {
+    return;
+  }
+  document_permission_state_ = true;
+  for (auto type : {ContentSettingsType::PERMISSION_AUTOBLOCKER_DATA,
+                    ContentSettingsType::PERMISSION_ACTIONS_HISTORY}) {
+    const auto* info = WebsiteSettingsRegistry::GetInstance()->Get(type);
+    content_settings_prefs_.emplace(
+        type, std::make_unique<ContentSettingsPref>(
+                  type, prefs_, &pref_change_registrar_, info->pref_name(),
+                  true, false,
+                  base::BindRepeating(&PrefProvider::Notify,
+                                      base::Unretained(this))));
+  }
+}
