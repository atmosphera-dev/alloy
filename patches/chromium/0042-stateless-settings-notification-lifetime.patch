--- a/components/content_settings/core/browser/host_content_settings_map.cc
+++ b/components/content_settings/core/browser/host_content_settings_map.cc
@@ -990,8 +990,14 @@
   DCHECK(primary_pattern.IsValid());
   DCHECK(secondary_pattern.IsValid());
   for (content_settings::Observer& observer : observers_) {
+    auto* registration = &observer;
     observer.OnContentSettingChanged(primary_pattern, secondary_pattern,
                                      content_type_set);
+    // The current callback may remove and destroy this observer. The legacy
+    // compatibility callback must honor that removal before invoking it again.
+    if (!observers_.HasObserver(registration)) {
+      continue;
+    }
     observer.OnContentSettingChanged(primary_pattern, secondary_pattern,
                                      content_type_set.GetTypeOrDefault());
   }
--- a/components/content_settings/core/browser/content_settings_observable_provider.cc
+++ b/components/content_settings/core/browser/content_settings_observable_provider.cc
@@ -32,8 +32,14 @@
   DCHECK(secondary_pattern.IsValid())
       << "pattern: " << secondary_pattern.ToString();
   for (Observer& observer : observer_list_) {
+    auto* registration = &observer;
     observer.OnContentSettingChanged(primary_pattern, secondary_pattern,
                                      ContentSettingsTypeSet(content_type));
+    // The current callback may remove and destroy this observer. The legacy
+    // compatibility callback must honor that removal before invoking it again.
+    if (!observer_list_.HasObserver(registration)) {
+      continue;
+    }
     observer.OnContentSettingChanged(primary_pattern, secondary_pattern,
                                      content_type);
   }
