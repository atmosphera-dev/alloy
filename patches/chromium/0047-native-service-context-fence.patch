+++ b/components/keyed_service/core/keyed_service_base_factory.cc
@@ -5,12 +5,42 @@
 #include "components/keyed_service/core/keyed_service_base_factory.h"
 
 #include <type_traits>
+#include <utility>
 
+#include "base/check_op.h"
 #include "base/supports_user_data.h"
 #include "base/trace_event/trace_event.h"
 #include "components/keyed_service/core/dependency_manager.h"
 #include "components/pref_registry/pref_registry_syncable.h"
 #include "components/prefs/pref_service.h"
+
+namespace {
+thread_local const KeyedServiceBaseFactory::ContextAccessCallbackForTesting*
+    g_context_access_observer_for_testing = nullptr;
+}  // namespace
+
+KeyedServiceBaseFactory::ScopedContextAccessObserverForTesting::
+    ScopedContextAccessObserverForTesting(
+        ContextAccessCallbackForTesting callback)
+    : callback_(std::move(callback)),
+      previous_(
+          std::exchange(g_context_access_observer_for_testing, &callback_)) {}
+
+KeyedServiceBaseFactory::ScopedContextAccessObserverForTesting::
+    ~ScopedContextAccessObserverForTesting() {
+  CHECK_EQ(g_context_access_observer_for_testing, &callback_);
+  g_context_access_observer_for_testing = previous_.get();
+}
+
+void KeyedServiceBaseFactory::NotifyContextAccessForTesting(
+    const void* requested,
+    const void* selected) const {
+  if (g_context_access_observer_for_testing) {
+    // A test callback can nest scopes. Keep its binding alive through the call.
+    auto callback = *g_context_access_observer_for_testing;
+    callback.Run(name(), requested, selected);
+  }
+}
 
