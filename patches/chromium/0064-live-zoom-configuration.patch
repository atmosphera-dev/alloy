+void ChromeZoomLevelPrefs::ReconcileZoomConfiguration() {
+  content::HostZoomMap::ZoomLevelVector levels;
+  const auto& partitions = pref_service_->GetDict(prefs::kPartitionPerHostZoomLevels);
+  if (const auto* hosts = partitions.FindDict(partition_key_)) {
+    for (auto [host, value] : *hosts) {
+      if (host.empty()) continue;
+      const auto* dictionary = value.GetIfDict();
+      auto level = dictionary ? dictionary->FindDouble(kZoomLevelKey) : value.GetIfDouble();
+      if (!level) continue;
+      levels.push_back({content::HostZoomMap::ZOOM_CHANGED_FOR_HOST, host,
+                        std::string(), *level,
+                        dictionary ? GetTimeStamp(*dictionary) : base::Time()});
+    }
+  }
+  auto weak = weak_factory_.GetWeakPtr();
+  host_zoom_map_->ReplacePersistentZoomLevels(GetDefaultZoomLevelPref(), std::move(levels));
+  if (!weak) return;
+  const double current_default = host_zoom_map_->GetDefaultZoomLevel();
+  if (blink::ZoomValuesEqual(current_default, notified_default_zoom_)) return;
+  notified_default_zoom_ = current_default;
+  auto callbacks = default_zoom_changed_callbacks_;
+  callbacks->Notify();
+  if (weak && zoom_event_manager_) zoom_event_manager_->OnDefaultZoomLevelChanged();
+}
