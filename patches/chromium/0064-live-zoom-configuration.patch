+void HostZoomMapImpl::ReplacePersistentZoomLevels(double default_level,
+                                                 ZoomLevelVector levels) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI, base::NotFatalUntil::M160);
+  HostZoomLevels next;
+  for (const auto& entry : levels) {
+    CHECK_EQ(entry.mode, ZOOM_CHANGED_FOR_HOST);
+    if (!entry.host.empty() &&
+        !blink::ZoomValuesEqual(entry.zoom_level, default_level)) {
+      next[entry.host] = {entry.zoom_level, entry.last_modified};
+    }
+  }
+  std::set<std::string> changed;
+  for (const auto& [host, value] : host_zoom_levels_) {
+    const auto found = next.find(host);
+    if (found == next.end() ||
+        !blink::ZoomValuesEqual(found->second.level, value.level) ||
+        found->second.last_modified != value.last_modified) changed.insert(host);
+  }
+  for (const auto& [host, value] : next) {
+    if (!host_zoom_levels_.contains(host)) changed.insert(host);
+  }
+  const bool default_changed =
+      !blink::ZoomValuesEqual(default_level, default_zoom_level_);
+  if (!default_changed && changed.empty()) return;
+
+  // One publication boundary: observers can never see a new default with old
+  // hosts, nor a partly removed set of hosts during record revocation.
+  host_zoom_levels_ = std::move(next);
+  default_zoom_level_ = default_level;
+  auto weak = weak_factory_.GetWeakPtr();
+  for (const auto& host : changed) {
+    SendZoomLevelChange(std::string(), host);
+    if (!weak) return;
+    ZoomLevelChange event = {ZOOM_CHANGED_FOR_HOST, host, std::string(),
+                            GetZoomLevelForHost(host), base::Time(), true};
+    NotifyZoomLevelChanged(event);
+    if (!weak) return;
+  }
+  if (default_changed) {
+    for (auto contents : WebContentsImpl::GetAllWebContents()) {
+      if (GetForWebContents(contents) != this) continue;
+      auto id = contents->GetPrimaryMainFrame()->GetGlobalId();
+      if (!UsesTemporaryZoomLevel(id)) contents->UpdateZoom(id);
+      if (!weak) return;
+    }
+    if (IsIndependentSubframeZoomEnabled()) {
+      const auto nodes = independent_zoom_frame_tree_nodes_;
+      for (auto id : nodes) {
+        auto* node = FrameTreeNode::GloballyFindByID(id);
+        if (!node) continue;
+        auto* frame = node->current_frame_host();
+        auto* contents = WebContentsImpl::FromRenderFrameHostImpl(frame);
+        if (contents && frame != contents->GetPrimaryMainFrame() &&
+            !UsesTemporaryZoomLevel(frame->GetGlobalId())) {
+          contents->UpdateZoom(frame->GetGlobalId());
+          if (!weak) return;
+        }
+      }
+    }
+    ZoomLevelChange event = {ZOOM_CHANGED_FOR_HOST, std::string(),
+                            std::string(), default_zoom_level_, base::Time(), true};
+    NotifyZoomLevelChanged(event);
+  }
 }
 
