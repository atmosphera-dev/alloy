+namespace content {
+void SharedWorkerHost::TerminateAndNotify(base::OnceClosure done) {
+  auto worker = std::make_unique<mojo::Remote<blink::mojom::SharedWorker>>(std::move(worker_));
+  if (!worker->is_bound() || !worker->is_connected()) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, std::move(done));
+    return;
+  }
+  (*worker)->Terminate();
+  auto* pipe = worker.get();
+  pipe->set_disconnect_handler(base::BindOnce(
+      [](std::unique_ptr<mojo::Remote<blink::mojom::SharedWorker>> worker,
+         base::OnceClosure done) { std::move(done).Run(); }, std::move(worker), std::move(done)));
+}
+}  // namespace content
