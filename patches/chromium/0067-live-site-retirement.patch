+  auto* host = GetSharedWorkerHostFromToken(token);
+  if (!host) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, std::move(done));
+    return;
+  }
+  host->TerminateAndNotify(std::move(done));
+  host->Destruct();
+}
