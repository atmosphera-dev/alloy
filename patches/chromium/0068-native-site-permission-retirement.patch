+base::OnceClosure PermissionContextBase_ChromiumImpl::PreparePermissionRequestRetirement(
+    const content_settings::SitePermissionMatcher& owns) {
+  std::vector<BrowserPermissionCallback> callbacks;
+  for (auto& [id, pending] : pending_requests_) {
+    const auto& request = pending.first;
+    if (owns.Run(url::Origin::Create(request->requesting_origin())) ||
+        owns.Run(url::Origin::Create(request->embedding_origin()))) {
+      retired_requests_.insert(id);
+      if (pending.second) callbacks.push_back(std::move(pending.second));
+    }
+  }
+  return base::BindOnce([](std::vector<BrowserPermissionCallback> callbacks) {
+    for (auto& callback : callbacks)
+      std::move(callback).Run(content::PermissionResult(PermissionStatus::DENIED));
+  }, std::move(callbacks));
+}
