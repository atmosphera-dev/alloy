+base::OnceClosure ChromeFileSystemAccessPermissionContext::PrepareSitePermissionRetirement(
+    const content_settings::SitePermissionMatcher& owns) {
+  std::vector<scoped_refptr<PermissionGrantImpl>> notifications;
+  for (auto it = active_permissions_map_.begin(); it != active_permissions_map_.end();) {
+    if (!owns.Run(it->first)) { ++it; continue; }
+    // Hold all selected grants, detach their slots and close admission before
+    // any observer can reenter and obtain a genuinely fresh slot.
+    std::vector<scoped_refptr<PermissionGrantImpl>> selected;
+    for (const auto& entry : it->second.read_grants) selected.emplace_back(entry.second.get());
+    for (const auto& entry : it->second.write_grants) selected.emplace_back(entry.second.get());
+    it = active_permissions_map_.erase(it);
+    for (auto& grant : selected)
+      if (grant->PrepareRetirement()) notifications.push_back(std::move(grant));
+  }
+  auto notify_objects = permissions::ObjectPermissionContextBase::PrepareSitePermissionRetirement(owns);
+  return base::BindOnce([](std::vector<scoped_refptr<PermissionGrantImpl>> grants,
+                          base::OnceClosure objects) {
+    for (auto& grant : grants) grant->NotifyRetirement();
+    if (objects) std::move(objects).Run();
+  }, std::move(notifications), std::move(notify_objects));
+}
