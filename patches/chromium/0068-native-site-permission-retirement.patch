+base::OnceClosure ObjectPermissionContextBase::PrepareSitePermissionRetirement(
+    const content_settings::SitePermissionMatcher& owns) {
+  std::set<url::Origin> retired;
+  for (const auto& object : GetAllGrantedObjects()) {
+    auto origin = url::Origin::Create(object->origin);
+    if (owns.Run(origin)) retired.insert(std::move(origin));
+  }
+  for (const auto& origin : origins_with_scheduled_save_settings_calls_)
+    if (owns.Run(origin)) retired.insert(origin);
+  for (const auto& entry : objects_)
+    if (owns.Run(entry.first)) retired.insert(entry.first);
+  for (const auto& origin : retired) origins_with_scheduled_save_settings_calls_.erase(origin);
+  std::erase_if(objects_, [&](const auto& entry) { return owns.Run(entry.first); });
+  for (const auto& origin : retired)
+    RevokeEphemeralPermissions(ContentSettingsPattern::FromURLNoWildcard(origin.GetURL()), true);
+  return base::BindOnce([](base::WeakPtr<ObjectPermissionContextBase> owner,
+                          std::set<url::Origin> origins) {
+    for (const auto& origin : origins) {
+      if (!owner) return;
+      owner->NotifyPermissionRevoked(origin);
+    }
+  }, weak_factory_.GetWeakPtr(), std::move(retired));
+}
