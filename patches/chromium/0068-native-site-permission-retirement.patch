+base::RepeatingCallback<bool()> HostContentSettingsMap::CapturePermissionAdmission(
+    const url::Origin& origin) {
+  DCHECK(thread_checker_.CalledOnValidThread());
+  if (!prefs_) return base::BindRepeating([] { return false; });
+  auto& epoch = permission_epochs_[origin];
+  if (!epoch) epoch = std::make_unique<SitePermissionEpoch>();
+  return base::BindRepeating([](base::WeakPtr<SitePermissionEpoch> original) {
+    return !!original;
+  }, epoch->weak.GetWeakPtr());
+}
+
+base::OnceClosure HostContentSettingsMap::PrepareSitePermissionRetirement(
+    const content_settings::SitePermissionMatcher& owns) {
+  DCHECK(thread_checker_.CalledOnValidThread());
+  scoped_refptr<HostContentSettingsMap> alive(this);
+  std::erase_if(permission_epochs_, [&](const auto& entry) { return owns.Run(entry.first); });
+  std::vector<base::OnceClosure> notifications;
+  for (auto& observer : observers_) {
+    auto notify = observer.PrepareSitePermissionRetirement(owns);
+    if (notify) notifications.push_back(std::move(notify));
+  }
+  return base::BindOnce([](scoped_refptr<HostContentSettingsMap> map,
+      content_settings::SitePermissionMatcher owns, std::vector<base::OnceClosure> notifications) {
+    // Clear native one-time/session providers as well as the already-pruned
+    // pref projection. Global defaults and external policy are not rewritten.
+    for (const auto* info : *content_settings::WebsiteSettingsRegistry::GetInstance()) {
+      if (!map->prefs_) return;
+      map->ClearSettingsForOneTypeWithPredicate(info->type(),
+          [&](const ContentSettingPatternSource& setting) {
+            for (const auto& pattern : {setting.primary_pattern, setting.secondary_pattern}) {
+              const auto origin = url::Origin::Create(pattern.ToRepresentativeUrl());
+              if (!origin.opaque() && owns.Run(origin)) return true;
+            }
+            return false;
+          });
+    }
+    for (auto& notify : notifications) std::move(notify).Run();
+  }, std::move(alive), owns, std::move(notifications));
+}
