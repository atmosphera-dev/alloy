+bool PermissionManager::RetireSitePermissions(const content_settings::SitePermissionMatcher& owns) {
+  scoped_refptr<HostContentSettingsMap> map = PermissionsClient::Get()->GetSettingsMap(browser_context_);
+  if (!map) return false;
+  auto notify_objects = map->PrepareSitePermissionRetirement(owns);
+  std::vector<base::OnceClosure> notifications;
+  for (auto& entry : permission_contexts_) {
+    auto notify = entry.second->PreparePermissionRequestRetirement(owns);
+    if (notify) notifications.push_back(std::move(notify));
+  }
+  std::vector<PendingRequestLocalId> removed;
+  for (PendingRequestsMap::iterator it(&pending_requests_); !it.IsAtEnd(); it.Advance()) {
+    auto* request = it.GetCurrentValue();
+    auto* frame = content::RenderFrameHost::FromID(request->render_process_id(), request->render_frame_id());
+    if (frame && owns.Run(frame->GetLastCommittedOrigin())) {
+      auto reply = request->TakeCallback();
+      auto denied = std::vector<content::PermissionResult>(request->permissions().size(),
+          content::PermissionResult(PermissionStatus::DENIED));
+      notifications.push_back(base::BindOnce(std::move(reply), std::move(denied)));
+      removed.push_back(it.GetCurrentKey());
+    }
+  }
+  for (const auto id : removed) pending_requests_.Remove(id);
+  if (notify_objects) std::move(notify_objects).Run();
+  for (auto& notify : notifications) std::move(notify).Run();
+  return true;
+}
