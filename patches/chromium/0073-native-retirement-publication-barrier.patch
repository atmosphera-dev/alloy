+
+base::OnceClosure ProtocolHandlerRegistry::PrepareSitePermissionRetirement(
+    const content_settings::SitePermissionMatcher& owns) {
+  auto selected = [&](const ProtocolHandler& handler) {
+    return owns.Run(url::Origin::Create(handler.url())) &&
+        !std::ranges::contains(predefined_protocol_handlers_, handler);
+  };
+  for (auto& [protocol, handlers] : user_protocol_handlers_) {
+    std::vector<ProtocolHandler> removed;
+    for (const auto& handler : handlers) if (selected(handler)) removed.push_back(handler);
+    std::erase_if(handlers, selected);
+    auto& live = protocol_handlers_[protocol];
+    for (const auto& handler : removed) {
+      if (!HandlerExists(handler, &policy_protocol_handlers_))
+        std::erase(live, handler);
+    }
+    retirement_changed_ |= !removed.empty();
+    auto current = default_handlers_.find(protocol);
+    if (current != default_handlers_.end() &&
+        !std::ranges::contains(live, current->second)) {
+      default_handlers_.erase(current);
+      if (!live.empty()) default_handlers_.emplace(protocol, live.front());
+    }
+  }
+  std::erase_if(user_protocol_handlers_, [](const auto& entry) { return entry.second.empty(); });
+  for (const auto& handler : user_ignored_protocol_handlers_) if (selected(handler)) {
+    retirement_changed_ = true;
+    if (!std::ranges::contains(policy_ignored_protocol_handlers_, handler))
+      std::erase(ignored_protocol_handlers_, handler);
+  }
+  std::erase_if(user_ignored_protocol_handlers_, selected);
+  return {};  // Never publish UI/pref notifications while revocation is draining.
+}
+
+void ProtocolHandlerRegistry::OnSitePermissionRetirementPublished() {
+  if (!retirement_changed_) return;
+  retirement_changed_ = false;
+  NotifyChanged();
+}
