+void HostContentSettingsMap::DrainSitePermissions(base::OnceCallback<void(bool)> done) {
+  size_t count = 1;
+  for (auto it = observers_.begin(); it != observers_.end(); ++it) ++count;
+  auto barrier = base::BarrierCallback<bool>(count, base::BindOnce(
+      [](scoped_refptr<HostContentSettingsMap>, base::OnceCallback<void(bool)> done,
+         std::vector<bool> results) {
+        std::move(done).Run(std::ranges::all_of(results, [](bool ok) { return ok; }));
+      }, base::WrapRefCounted(this),
+      base::BindPostTask(base::SequencedTaskRunner::GetCurrentDefault(), std::move(done))));
+  for (auto& observer : observers_) observer.DrainSitePermissions(barrier);
+  barrier.Run(true);  // Completion cannot reenter the observer traversal.
+}
+
+base::OnceClosure HostContentSettingsMap::TakeSitePermissionRetirementPublication() {
+  CHECK_GT(retirement_publications_, 0u);
+  return base::BindOnce([](scoped_refptr<HostContentSettingsMap> map) {
+    CHECK_GT(map->retirement_publications_, 0u);
+    if (--map->retirement_publications_ || !map->prefs_) return;
+    auto pending = std::move(map->retirement_notifications_);
+    map->retirement_notifications_.clear();
+    for (auto& notify : pending) std::move(notify).Run();
+    for (auto& observer : map->observers_) observer.OnSitePermissionRetirementPublished();
+  }, base::WrapRefCounted(this));
+}
