+  if (unconditional) base::EraseIf(storage_access_eligible_connections_, [&](const auto& pair) {
+    return owns.Run(url::Origin::Create(pair.first.GetURL())) ||
+        owns.Run(url::Origin::Create(pair.second.GetURL()));
