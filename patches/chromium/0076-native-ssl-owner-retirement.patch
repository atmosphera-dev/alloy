+base::OnceClosure StatefulSSLHostStateDelegate::PrepareSitePermissionRetirement(
+    const content_settings::SitePermissionMatcher& owns) {
+  auto selected = base::BindRepeating(
+      [](const content_settings::SitePermissionMatcher& owns, const std::string& host) {
+        return owns.Run(url::Origin::Create(GetSecureGURLForHost(host)));
+      }, owns);
+  std::erase_if(allowed_certs_for_non_default_storage_partitions_,
+      [&](const auto& entry) { return selected.Run(entry.first); });
+  std::erase_if(ran_mixed_content_hosts_, [&](const auto& host) { return selected.Run(host); });
+  std::erase_if(ran_content_with_cert_errors_hosts_, [&](const auto& host) { return selected.Run(host); });
+  https_only_mode_allowlist_.RetireNonDefaultHosts(selected);
+  https_only_mode_enforcelist_.RetireNonDefaultHosts(selected);
+  // Persistent rules are already prepared by their native pref owner. Never
+  // manufacture a new pref write or external event while retiring live copies.
+  return {};
+}
 
