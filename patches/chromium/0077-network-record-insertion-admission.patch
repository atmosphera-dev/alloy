+SSLClientSessionCache::Insertion::Insertion(
+    base::WeakPtr<SSLClientSessionCache> owner,
+    Key key,
+    uint64_t configuration_generation)
+    : owner_(std::move(owner)),
+      key_(std::move(key)),
+      configuration_generation_(configuration_generation) {}
+
+SSLClientSessionCache::Insertion::~Insertion() = default;
+
+std::shared_ptr<const SSLClientSessionCache::Insertion>
+SSLClientSessionCache::CaptureInsertion(const Key& cache_key) {
+  std::erase_if(insertion_admissions_,
+               [](const auto& entry) { return entry.second.expired(); });
+  // RSA sessions can additionally be cached with the resolved address. Both
+  // representations belong to the same original native socket admission.
+  Key key = cache_key;
+  key.dest_ip_addr.reset();
+  auto& registered = insertion_admissions_[key];
+  auto admission = registered.lock();
+  if (!admission || !admission->admitted_ ||
+      admission->configuration_generation_ != generation_number_) {
+    admission = std::shared_ptr<Insertion>(new Insertion(
+        weak_factory_.GetWeakPtr(), std::move(key), generation_number_));
+    registered = admission;
+  }
+  return admission;
+}
+
+void SSLClientSessionCache::Insert(
+    const Insertion& original,
+    const Key& cache_key,
+    bssl::UniquePtr<SSL_SESSION> session) {
+  Key key = cache_key;
+  key.dest_ip_addr.reset();
+  if (original.owner_.get() != this || !original.admitted_ ||
+      original.configuration_generation_ != generation_number_ ||
+      original.key_ != key) {
+    return;
+  }
+  Insert(original.configuration_generation_, cache_key, std::move(session));
+}
+
+void SSLClientSessionCache::FlushMatching(
+    const base::RepeatingCallback<bool(const Key&)>& matches) {
+  // Admission must close before any cached SSL_SESSION is freed.
+  for (auto it = insertion_admissions_.begin();
+       it != insertion_admissions_.end();) {
+    auto admission = it->second.lock();
+    if (!admission || matches.Run(it->first)) {
+      if (admission) admission->admitted_ = false;
+      it = insertion_admissions_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  for (auto it = cache_.begin(); it != cache_.end();) {
+    if (matches.Run(it->first)) {
+      it = cache_.Erase(it);
+    } else {
+      ++it;
+    }
+  }
 }
 
