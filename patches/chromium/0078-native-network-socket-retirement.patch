+void TransportClientSocketPool::Group::IncrementActiveSocketCount(
+    StreamSocket* socket) {
+  CHECK(active_sockets_.try_emplace(socket).second);
+}
+
+void TransportClientSocketPool::Group::DecrementActiveSocketCount(
+    StreamSocket* socket) {
+  CHECK_EQ(active_sockets_.erase(socket), 1u);
+}
+
+void TransportClientSocketPool::Group::PrepareNetworkRetirement(
+    const base::RepeatingClosure& drained) {
+  IncrementGeneration();
+  for (auto& [socket, retirement] : active_sockets_) {
+    retirement.emplace_back(drained);
+    socket->Disconnect();
+  }
+  SetPendingErrorForAllBoundRequests(ERR_ABORTED);
+  for (auto& bound : bound_requests_) {
+    bound.network_retirement.emplace_back(drained);
+  }
+}
