+void TransportClientSocketPool::RetireMatchingGroups(
+    const base::RepeatingCallback<bool(const GroupId&)>& matches,
+    base::OnceClosure done) {
+  std::vector<GroupId> selected;
+  size_t pending = 1;  // Keep completion closed through synchronous preparation.
+  for (const auto& [id, group] : group_map_) {
+    if (matches.Run(id)) {
+      selected.push_back(id);
+      pending += group.NativeRetirementCount();
+    }
+  }
+  for (const auto& [handle, callback] : pending_callback_map_) {
+    if (matches.Run(handle->group_id())) ++pending;
+  }
+  auto drained = base::BarrierClosure(pending, base::BindOnce(
+      [](base::OnceClosure done) {
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, std::move(done));
+      }, std::move(done)));
+  // Prepare all selected original owners before cancelling any native work.
+  for (const auto& id : selected) {
+    group_map_.at(id).PrepareNetworkRetirement(drained);
+  }
+  for (auto& [handle, completion] : pending_callback_map_) {
+    if (matches.Run(handle->group_id())) {
+      completion.result = ERR_ABORTED;
+      completion.network_retirement.emplace_back(drained);
+    }
+  }
+  for (const auto& id : selected) {
+    auto it = group_map_.find(id);
+    if (it == group_map_.end()) continue;
+    Group* group = &it->second;
+    connecting_socket_count_ -= group->jobs().size();
+    group->RemoveAllUnboundJobs();
+    CleanupIdleSocketsInGroup(true, group, base::TimeTicks::Now(),
+                              "Site record retired");
+    while (auto request = group->PopNextUnboundRequest()) {
+      auto* handle = request->handle();
+      InvokeUserCallbackLater(handle, request->release_callback(), ERR_ABORTED,
+                              request->socket_tag());
+      pending_callback_map_.at(handle).network_retirement.emplace_back(drained);
+    }
+    if (group->IsEmpty()) RemoveGroup(id);
+  }
+  CheckForStalledSocketGroups();
+  drained.Run();
+}
