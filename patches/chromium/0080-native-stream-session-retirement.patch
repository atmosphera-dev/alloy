+bool HttpStreamPool::JobController::MatchesNetworkRecord(
+    const base::RepeatingCallback<bool(const HttpStreamKey&)>& matches) const {
+  return matches.Run(origin_stream_key_) ||
+         (alternative_ && matches.Run(alternative_->stream_key));
