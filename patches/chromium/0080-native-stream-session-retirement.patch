+void SpdySessionPool::RetireMatchingSessions(
+    const base::RepeatingCallback<bool(const SpdySessionKey&)>& matches,
+    base::OnceClosure done) {
+  WeakSessionList selected;
+  for (auto& session : GetCurrentSessions()) {
+    if (!session) continue;
+    bool owned = matches.Run(session->spdy_session_key());
+    for (const auto& alias : session->pooled_aliases())
+      owned = owned || matches.Run(alias);
+    if (owned) selected.push_back(session);
+  }
+  auto drained = base::BarrierClosure(selected.size() + 1, base::BindOnce(
+      [](base::OnceClosure done) {
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, std::move(done));
+      }, std::move(done)));
+  // Unmap every original owner before any stream close callback can reenter.
+  for (auto& session : selected) session->PrepareNetworkRetirement(drained);
+  for (auto& session : selected) if (session) session->RevokeNetworkState();
+  drained.Run();
+}
