+void HttpStreamPool::RetireMatchingStreams(
+    const base::RepeatingCallback<bool(const HttpStreamKey&)>& matches,
+    base::OnceClosure done) {
+  std::vector<base::WeakPtr<Group>> groups;
+  std::vector<JobController*> preparing;
+  size_t pending = 1;
+  for (auto& [key, group] : groups_) {
+    if (matches.Run(key)) {
+      groups.push_back(group.GetWeakPtr());
+      pending += group.NativeRetirementCount();
+    }
+  }
+  for (auto& controller : job_controllers_) {
+    if (controller->MatchesNetworkRecord(matches)) {
+      preparing.push_back(controller.get());
+      ++pending;
+    }
+  }
+  auto drained = base::BarrierClosure(pending, base::BindOnce(
+      [](base::OnceClosure done) {
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, std::move(done));
+      }, std::move(done)));
+  std::vector<base::WeakPtr<JobController>> controllers;
+  for (auto* controller : preparing)
+    controllers.push_back(controller->PrepareNetworkRetirement(drained));
+  for (auto& group : groups) group->PrepareNetworkRetirement(drained);
+  for (auto& group : groups) if (group) group->RevokeNetworkState();
+  for (auto& controller : controllers)
+    if (controller) controller->RevokeNetworkState();
+  drained.Run();
+}
