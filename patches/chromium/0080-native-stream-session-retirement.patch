+
+base::WeakPtr<HttpStreamPool::JobController>
+HttpStreamPool::JobController::PrepareNetworkRetirement(
+    const base::RepeatingClosure& drained) {
+  network_retirement_.emplace_back(drained);
+  if (!network_retired_) {
+    network_retired_ = true;
+    weak_ptr_factory_.InvalidateWeakPtrs();
+  }
+  return weak_ptr_factory_.GetWeakPtr();  // Cleanup view, not new admission.
+}
+
+void HttpStreamPool::JobController::RevokeNetworkState() {
+  if (network_retirement_started_) return;
+  network_retirement_started_ = true;
+  origin_job_.reset();
+  alternative_job_.reset();
+  pending_stream_.reset();
+  auto preconnect = std::move(preconnect_callback_);
+  if (stream_request_) {
+    if (!stream_request_->completed()) {
+      TaskRunner(priority_)->PostTask(FROM_HERE, base::BindOnce(
+          &JobController::CallOnStreamFailed, weak_ptr_factory_.GetWeakPtr(),
+          ERR_ABORTED, NetErrorDetails(), ResolveErrorInfo()));
+    }
+    // An Alt-Svc preconnect can coexist with a completed stream helper.
+    if (preconnect) std::move(preconnect).Run(ERR_ABORTED);
+  } else if (preconnect) {
+    auto retirement = std::move(network_retirement_);
+    // The existing pool callback destroys this controller. Hold drain through
+    // the caller's actual callback, including reentry, rather than its enqueue.
+    std::move(preconnect).Run(ERR_ABORTED);
+  }
+}
