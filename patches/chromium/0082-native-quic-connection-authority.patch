+class QuicClientSessionCache::ConnectionView final
+    : public SessionCache::ConnectionState {
+ public:
+  explicit ConnectionView(std::shared_ptr<Admission> admission)
+      : admission_(std::move(admission)) {}
+  void Insert(bssl::UniquePtr<SSL_SESSION> session,
+              const TransportParameters& params,
+              const ApplicationState* application_state) override {
+    if (admission_->cache)
+      admission_->cache->Insert(admission_->server, std::move(session), params,
+                                application_state);
+  }
+  std::unique_ptr<QuicResumptionState> Lookup(
+      QuicWallTime now, const SSL_CTX* ctx) override {
+    return admission_->cache
+        ? admission_->cache->Lookup(admission_->server, now, ctx) : nullptr;
+  }
+  void ClearEarlyData() override {
+    if (admission_->cache)
+      admission_->cache->ClearEarlyData(admission_->server);
+  }
+  void OnNewTokenReceived(absl::string_view token) override {
+    if (admission_->cache)
+      admission_->cache->OnNewTokenReceived(admission_->server, token);
+  }
+ private:
