+std::unique_ptr<SessionCache::ConnectionState>
+QuicClientSessionCache::CreateConnectionState(const QuicServerId& server_id) {
+  for (auto it=connections_.begin();it!=connections_.end();) {
+    if (it->second.expired()) it=connections_.erase(it); else ++it;
+  }
+  auto& registered=connections_[server_id.cache_key()];
+  auto admission=registered.lock();
+  if (!admission || !admission->cache) {
+    admission=std::make_shared<Admission>(this,server_id);
+    registered=admission;
+  }
+  return std::make_unique<ConnectionView>(std::move(admission));
+}
+
+void QuicClientSessionCache::RetireMatching(
+    const QuicCryptoClientConfig::ServerIdFilter& filter) {
+  // Close original access before releasing tickets or their associated state.
+  for (auto it=connections_.begin();it!=connections_.end();) {
+    auto admission=it->second.lock();
+    if (!admission || filter.Matches(admission->server)) {
+      if (admission) admission->cache=nullptr;
+      it=connections_.erase(it);
+    } else ++it;
+  }
+  for (auto it=cache_.begin();it!=cache_.end();) {
+    if (filter.Matches(it->second->server_id)) it=cache_.Erase(it); else ++it;
+  }
+}
+
+QuicClientSessionCache::~QuicClientSessionCache() {
+  for (auto& [key,registered] : connections_) {
+    if (auto admission=registered.lock()) admission->cache=nullptr;
+  }
+  connections_.clear();
+  Clear();
+}
 
