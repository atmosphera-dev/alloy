+std::vector<std::unique_ptr<QuicCryptoClientConfig::CachedState>>
+QuicCryptoClientConfig::DetachMatchingServerState(
+    const ServerIdFilter& filter) {
+  std::vector<std::unique_ptr<CachedState>> detached;
+  for (auto it = cached_states_.begin(); it != cached_states_.end();) {
+    if (filter.Matches(it->first)) {
+      it->second->Clear();
+      detached.push_back(std::move(it->second));
+      it = cached_states_.erase(it);
+    } else
+      ++it;
+  }
+  for (auto it = canonical_server_map_.begin();
+       it != canonical_server_map_.end();) {
+    if (filter.Matches(it->first) || filter.Matches(it->second))
+      it = canonical_server_map_.erase(it);
+    else
+      ++it;
+  }
+  return detached;
+}
