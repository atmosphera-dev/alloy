+// Own the socket and continuation across the async creation boundary. A weak
+// callback alone on the attempt cannot stop pool work that outlives that
+// attempt.
+class QuicSessionPool::PendingSessionCreation {
+ public:
+  PendingSessionCreation(QuicSessionPool* pool,
+                         const QuicSessionAliasKey& key,
+                         std::unique_ptr<DatagramClientSocket> socket)
+      : pool_(pool), key_(key), socket_(std::move(socket)) {}
+  base::WeakPtr<PendingSessionCreation> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+  void Complete(int rv) {
+    auto node = pool_->pending_session_creations_.extract(this);
+    auto owned = std::move(node.mapped());
+    pool_ = nullptr;
+    auto callback = std::move(callback_);
+    std::move(callback).Run(rv);
+  }
+  raw_ptr<QuicSessionPool> pool_;
+  const QuicSessionAliasKey key_;
+  std::unique_ptr<DatagramClientSocket> socket_;
+  CompletionOnceCallback callback_;
+  base::WeakPtrFactory<PendingSessionCreation> weak_factory_{this};
+};
