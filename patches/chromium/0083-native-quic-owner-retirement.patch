+void QuicSessionPool::RetireNetworkState(const NetworkRecordMatcher& matches,
+                                         base::OnceClosure done) {
+  class Filter final : public quic::QuicCryptoClientConfig::ServerIdFilter {
+   public:
+    Filter(const NetworkRecordMatcher& matches,
+           const QuicCryptoClientConfigKey& key)
+        : matches_(matches), key_(key) {}
+    bool Matches(const quic::QuicServerId& server) const override {
+      return matches_.Run(key_.network_anonymization_key, server,
+                          key_.session_usage);
+    }
+
+   private:
+    const NetworkRecordMatcher& matches_;
+    const QuicCryptoClientConfigKey& key_;
+  };
+  std::vector<std::unique_ptr<quic::QuicCryptoClientConfig::CachedState>>
+      states;
+  auto retire_config = [&](const auto& key, auto& owner) {
+    Filter filter(matches, key);
+    owner->RetireSessionCache(filter);
+    auto detached = owner->config()->DetachMatchingServerState(filter);
+    for (auto& state : detached)
+      states.push_back(std::move(state));
+  };
+  for (auto& [key, owner] : active_crypto_config_map_)
+    retire_config(key, owner);
+  for (auto& [key, owner] : recent_crypto_config_map_)
+    retire_config(key, owner);
+  std::vector<base::WeakPtr<QuicChromiumClientSession>> sessions;
+  auto owned = [&](const QuicSessionKey& key) {
+    return matches.Run(key.network_anonymization_key(), key.server_id(),
+                       key.session_usage());
+  };
+  for (auto& session : all_sessions_) {
+    bool selected = owned(session->quic_session_key());
+    auto aliases = session_aliases_.find(session.get());
+    if (aliases != session_aliases_.end())
+      for (const auto& alias : aliases->second)
+        selected = selected || owned(alias.session_key());
+    if (selected)
+      sessions.push_back(session->NetworkRetirementView());
+  }
+  std::vector<std::unique_ptr<PendingSessionCreation>> creations;
+  for (auto it = pending_session_creations_.begin();
+       it != pending_session_creations_.end();) {
+    if (owned(it->second->key_.session_key())) {
+      creations.push_back(std::move(it->second));
+      it = pending_session_creations_.erase(it);
+    } else
+      ++it;
+  }
+  std::vector<std::unique_ptr<Job>> jobs;
+  std::vector<base::OnceClosure> notify;
+  for (auto it = active_jobs_.begin(); it != active_jobs_.end();) {
+    if (owned(it->first)) {
+      auto job = std::move(it->second);
+      it = active_jobs_.erase(it);
+      job->set_is_deleting();
+      while (!job->requests().empty()) {
+        auto* request = job->requests().begin()->get();
+        job->RemoveRequest(request);
+        notify.push_back(request->PrepareNetworkRetirement());
+      }
+      jobs.push_back(std::move(job));
+    } else
+      ++it;
+  }
+  for (auto it = gone_away_aliases_.begin(); it != gone_away_aliases_.end();) {
+    if (owned(it->session_key()))
+      it = gone_away_aliases_.erase(it);
+    else
+      ++it;
+  }
+  auto drained = base::BarrierClosure(
+      sessions.size() + 3,
+      base::BindOnce(
+          [](decltype(states) states, base::OnceClosure done) {
+            base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+                FROM_HERE,
+                base::BindOnce(
+                    [](decltype(states) states, base::OnceClosure done) {
+                      states.clear();
+                      std::move(done).Run();
+                    },
+                    std::move(states), std::move(done)));
+          },
+          std::move(states), std::move(done)));
+  auto modern = session_attempt_manager_->PrepareNetworkRetirement(
+      matches, drained, &notify);
+  for (auto& session : sessions)
+    session->PrepareNetworkRetirement(drained);
+  creations
+      .clear();  // Destroys sockets and invalidates original continuations.
+  std::move(modern).Run();
+  jobs.clear();
+  for (auto& session : sessions)
+    if (session)
+      session->RevokeNetworkState();
+  for (auto& callback : notify)
+    std::move(callback).Run();
+  drained.Run();  // Legacy jobs and their actual callbacks have drained.
+  drained.Run();  // Synchronous preparation/revocation is finished.
 }
 
