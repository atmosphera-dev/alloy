+void QuicChromiumClientSession::PrepareNetworkRetirement(
+    const base::RepeatingClosure& drained) {
+  network_retirement_.emplace_back(drained);
+  if (!network_retired_) {
+    network_retired_ = true;
+    NotifyFactoryOfSessionGoingAway();
+  }
+}
+
+void QuicChromiumClientSession::RevokeNetworkState() {
+  if (network_revoke_started_)
+    return;
+  network_revoke_started_ = true;
+  // Close transport/handles now; native asynchronous removal owns completion.
+  CloseSessionOnErrorLater(ERR_ABORTED, quic::QUIC_CONNECTION_CANCELLED,
+                           quic::ConnectionCloseBehavior::SILENT_CLOSE);
