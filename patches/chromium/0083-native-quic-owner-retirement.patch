+base::OnceClosure QuicSessionAttemptManager::PrepareNetworkRetirement(
+    const QuicSessionPool::NetworkRecordMatcher& matches,
+    base::OnceClosure drained,
+    std::vector<base::OnceClosure>* notify) {
+  std::vector<std::unique_ptr<Job>> jobs;
+  for (auto it = active_jobs_.begin(); it != active_jobs_.end();) {
+    const auto& key = it->first.session_key();
+    if (matches.Run(key.network_anonymization_key(), key.server_id(),
+                    key.session_usage())) {
+      auto callbacks = it->second->DetachNetworkRetirementRequests();
+      for (auto& callback : callbacks)
+        notify->push_back(std::move(callback));
+      jobs.push_back(std::move(it->second));
+      it = active_jobs_.erase(it);
+    } else
+      ++it;
+  }
+  return base::BindOnce(
+      [](std::vector<std::unique_ptr<Job>> jobs, base::OnceClosure drained) {
+        base::ScopedClosureRunner finish(std::move(drained));
+        for (auto& job : jobs)
+          job->RevokeNetworkState();
+        jobs.clear();
+      },
+      std::move(jobs), std::move(drained));
+}
 
