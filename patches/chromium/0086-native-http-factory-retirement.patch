+bool HttpStreamFactory::JobController::MatchesNetworkRecord(
+    const NetworkRecordMatcher& matches) const {
+  if (matches.Run(request_info_.network_anonymization_key,
+                  url::SchemeHostPort(request_info_.url)))
+    return true;
+  for (const auto* job :
+       {main_job_.get(), alternative_job_.get(), dns_alpn_h3_job_.get(),
+        ws_over_h3_job_.get(), preconnect_backup_job_.get()})
+    if (job && job->MatchesNetworkRecord(matches))
+      return true;
+  return false;
+}
+
+base::WeakPtr<HttpStreamFactory::JobController>
+HttpStreamFactory::JobController::PrepareNetworkRetirement(
+    const base::RepeatingClosure& drained) {
+  network_retirement_->emplace_back(drained);
+  if (!network_retired_) {
+    network_retired_ = true;
+    ptr_factory_.InvalidateWeakPtrs();
+  }
+  return ptr_factory_.GetWeakPtr();
+}
+
+void HttpStreamFactory::JobController::RevokeNetworkState() {
+  if (network_revoke_started_)
+    return;
+  network_revoke_started_ = true;
+  resume_main_job_callback_.Cancel();
+  proxy_resolve_request_.reset();
+  next_state_ = STATE_NONE;
+  bound_job_ = nullptr;
+  job_bound_ = false;
+  main_job_.reset();
+  alternative_job_.reset();
+  dns_alpn_h3_job_.reset();
+  ws_over_h3_job_.reset();
+  preconnect_backup_job_.reset();
+  if (!request_) {
+    auto retirement = std::move(network_retirement_);
+    auto preconnect = std::move(preconnect_callback_);
+    factory_->OnJobControllerComplete(this);
+    // The native factory destroyed this controller. Drain includes reentry.
+    if (preconnect)
+      std::move(preconnect).Run();
+    return;
+  }
+  if (!request_->completed())
+    TaskRunner(priority_)->PostTask(
+        FROM_HERE, base::BindOnce(&JobController::NotifyRequestFailed,
+                                  ptr_factory_.GetWeakPtr(), ERR_ABORTED));
+}
