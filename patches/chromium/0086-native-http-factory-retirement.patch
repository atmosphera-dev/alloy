+void HttpStreamFactory::RetireNetworkState(const NetworkRecordMatcher& matches,
+                                           base::OnceClosure done) {
+  std::vector<JobController*> selected;
+  for (const auto& controller : job_controller_set_)
+    if (controller->MatchesNetworkRecord(matches))
+      selected.push_back(controller.get());
+  auto drained = base::BarrierClosure(
+      selected.size() + 1,
+      base::BindOnce(
+          [](base::OnceClosure done) {
+            base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+                FROM_HERE, std::move(done));
+          },
+          std::move(done)));
+  std::vector<base::WeakPtr<JobController>> originals;
+  for (auto* controller : selected)
+    originals.push_back(controller->PrepareNetworkRetirement(drained));
+  for (auto& controller : originals)
+    if (controller)
+      controller->RevokeNetworkState();
+  drained.Run();
+}
