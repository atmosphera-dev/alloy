+void WebSocket::RevokeNetworkState() {
+  if (!native_retirement_.BeginRevocation())
+    return;
+  auto callback_lifetime = native_retirement_.HoldCallback();
+  if (handshake_client_)
+    handshake_client_->OnFailure("Site record retired", net::ERR_ABORTED, -1);
+  if (client_)
+    client_->OnDropChannel(false,
+                           static_cast<uint16_t>(net::kWebSocketErrorGoingAway),
+                           "Site record retired");
+  Reset();
+}
