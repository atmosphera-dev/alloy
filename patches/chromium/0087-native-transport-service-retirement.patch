+void WebTransport::RevokeNetworkState() {
+  if (!native_retirement_.BeginRevocation())
+    return;
+  auto callback_lifetime = native_retirement_.HoldCallback();
+  receiver_.reset();
+  if (handshake_client_)
+    handshake_client_->OnHandshakeFailed(
+        net::WebTransportError(net::ERR_ABORTED));
+  handshake_client_.reset();
+  client_.reset();
+  ClearDatagramState();
+  context_->Remove(this);
+}
