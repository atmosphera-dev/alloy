+base::OnceClosure WebSocketFactory::PrepareNetworkRetirement(
+    const NativeNetworkOwnerMatcher& matches,
+    base::OnceClosure done) {
+  std::vector<WebSocket*> selected;
+  for (const auto& socket : connections_)
+    if (socket->MatchesNetworkOwner(matches))
+      selected.push_back(socket.get());
+  auto drained = base::BarrierClosure(
+      selected.size() + 1,
+      base::BindOnce(
+          [](base::OnceClosure done) {
+            base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+                FROM_HERE, std::move(done));
+          },
+          std::move(done)));
+  std::vector<base::WeakPtr<WebSocket>> originals;
+  for (auto* socket : selected)
+    originals.push_back(socket->PrepareNetworkRetirement(drained));
+  return CommitNetworkRetirementOnDrop(base::BindOnce(
+      [](std::vector<base::WeakPtr<WebSocket>> originals,
+         base::ScopedClosureRunner finish) {
+        for (auto& socket : originals)
+          if (socket)
+            socket->RevokeNetworkState();
+      },
+      std::move(originals), base::ScopedClosureRunner(drained)));
+}
