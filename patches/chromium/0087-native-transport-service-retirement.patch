+base::OnceClosure NetworkContext::PrepareTransportServiceRetirement(
+    const NativeNetworkOwnerMatcher& matches,
+    base::OnceClosure done) {
+  std::vector<WebTransport*> selected;
+  for (const auto& transport : web_transports_)
+    if (transport->MatchesNetworkOwner(matches))
+      selected.push_back(transport.get());
+  auto drained = base::BarrierClosure(
+      selected.size() + 2,
+      base::BindOnce(
+          [](base::OnceClosure done) {
+            base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+                FROM_HERE, std::move(done));
+          },
+          std::move(done)));
+  std::vector<base::WeakPtr<WebTransport>> originals;
+  for (auto* transport : selected)
+    originals.push_back(transport->PrepareNetworkRetirement(drained));
+  base::OnceClosure sockets;
+#if BUILDFLAG(ENABLE_WEBSOCKETS)
+  if (websocket_factory_)
+    sockets = websocket_factory_->PrepareNetworkRetirement(matches, drained);
+  else
+    drained.Run();
+#else
+  drained.Run();
+#endif
+  return CommitNetworkRetirementOnDrop(base::BindOnce(
+      [](std::vector<base::WeakPtr<WebTransport>> originals,
+         base::OnceClosure sockets, base::ScopedClosureRunner finish) {
+        for (auto& transport : originals)
+          if (transport)
+            transport->RevokeNetworkState();
+        if (sockets)
+          std::move(sockets).Run();
+      },
+      std::move(originals), std::move(sockets),
+      base::ScopedClosureRunner(drained)));
+}
