+void PreflightCache::RetireMatching(const NativeNetworkOwnerMatcher& matches) {
+  for (auto it = cache_.begin(); it != cache_.end();) {
+    const auto& [origin, url, nik] = it->first;
+    auto key = net::NetworkAnonymizationKey::CreateFromNetworkIsolationKey(nik);
+    if (matches.Run({GURL(url), key, origin, nullptr}))
+      it = cache_.erase(it);
+    else
+      ++it;
+  }
