+base::OnceClosure WebBundleURLLoaderFactory::PrepareNetworkRetirement(
+    const NativeNetworkOwnerMatcher& matches,
+    bool retire_factory,
+    base::OnceClosure done) {
+  std::erase_if(active_loaders_, [](const auto& item) { return !item.second; });
+  std::vector<base::WeakPtr<URLLoader>> selected;
+  for (const auto& [pointer, loader] : active_loaders_)
+    if (loader && (retire_factory || loader->MatchesNetworkOwner(matches)))
+      selected.push_back(loader);
+  auto drained = base::BarrierClosure(
+      selected.size() + 1 + (retire_factory ? 1 : 0),
+      base::BindOnce(
+          [](base::OnceClosure done) {
+            base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+                FROM_HERE, std::move(done));
+          },
+          std::move(done)));
+  if (retire_factory && native_retirement_.Prepare(drained))
+    weak_ptr_factory_.InvalidateWeakPtrs();
+  std::vector<base::WeakPtr<URLLoader>> originals;
+  for (auto& loader : selected)
+    originals.push_back(loader->PrepareNetworkRetirement(drained));
+  return CommitNetworkRetirementOnDrop(base::BindOnce(
+      [](base::WeakPtr<WebBundleURLLoaderFactory> factory, bool retire_factory,
+         std::vector<base::WeakPtr<URLLoader>> originals,
+         base::ScopedClosureRunner finish) {
+        for (auto& loader : originals)
+          if (loader)
+            loader->OnFail(net::ERR_ABORTED);
+        if (factory && retire_factory)
+          factory->RevokeNetworkState();
+      },
+      GetLifetimeView(), retire_factory, std::move(originals),
+      base::ScopedClosureRunner(drained)));
+}
+void WebBundleURLLoaderFactory::RevokeNetworkState() {
+  if (!native_retirement_.BeginRevocation())
+    return;
+  auto lifetime = native_retirement_.HoldCallback();
+  CloseParserAndClients();
+  source_.reset();
+  metadata_.reset();
+  pending_loaders_.clear();
+  web_bundle_handle_.reset();
+}
+void WebBundleURLLoaderFactory::CloseParserAndClients() {
+  if (parser_receiver_)
+    parser_receiver_->Close();
+  parser_.reset();
+  auto clients = std::move(client_receivers_);
+  for (auto& client : clients)
+    if (client) {
+      client->impl()->OnComplete(URLLoaderCompletionStatus(net::ERR_ABORTED));
+      if (client)
+        client->Close();
+    }
+}
