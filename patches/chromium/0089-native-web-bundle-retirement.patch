+base::OnceClosure WebBundleManager::PrepareNetworkRetirement(
+    const NativeNetworkOwnerMatcher& matches,
+    base::OnceClosure done) {
+  for (auto it = factories_.begin(); it != factories_.end();) {
+    if (it->second->MatchesNetworkOwner(matches)) {
+      retiring_factories_.insert(std::move(it->second));
+      it = factories_.erase(it);
+    } else
+      ++it;
+  }
+  std::vector<base::WeakPtr<WebBundleURLLoaderFactory::URLLoader>> pending;
+  for (const auto& [key, loaders] : pending_loaders_)
+    for (const auto& loader : loaders)
+      if (WebBundleURLLoaderFactory::LoaderMatchesNetworkOwner(loader, matches))
+        pending.push_back(loader);
+  auto drained = base::BarrierClosure(
+      factories_.size() + retiring_factories_.size() + pending.size() + 1,
+      base::BindOnce(
+          [](base::OnceClosure done) {
+            base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+                FROM_HERE, std::move(done));
+          },
+          std::move(done)));
+  std::vector<base::OnceClosure> prepared;
+  for (const auto& [key, factory] : factories_)
+    prepared.push_back(
+        factory->PrepareNetworkRetirement(matches, false, drained));
+  std::vector<base::WeakPtr<WebBundleURLLoaderFactory>> retiring;
+  for (const auto& factory : retiring_factories_) {
+    prepared.push_back(
+        factory->PrepareNetworkRetirement(matches, true, drained));
+    retiring.push_back(factory->GetLifetimeView());
+  }
+  std::vector<base::WeakPtr<WebBundleURLLoaderFactory::URLLoader>> originals;
+  for (const auto& loader : pending)
+    originals.push_back(
+        WebBundleURLLoaderFactory::PrepareLoaderNetworkRetirement(loader,
+                                                                  drained));
+  return CommitNetworkRetirementOnDrop(base::BindOnce(
+      [](base::WeakPtr<WebBundleManager> manager,
+         std::vector<base::OnceClosure> prepared,
+         std::vector<base::WeakPtr<WebBundleURLLoaderFactory::URLLoader>>
+             originals,
+         std::vector<base::WeakPtr<WebBundleURLLoaderFactory>> retiring,
+         base::ScopedClosureRunner finish) {
+        for (auto& loader : originals)
+          WebBundleURLLoaderFactory::CancelLoader(loader, net::ERR_ABORTED);
+        for (auto& commit : prepared)
+          std::move(commit).Run();
+        for (auto& factory : retiring)
+          if (factory && manager)
+            manager->DestroyRetiringFactory(factory.get());
+      },
+      weak_ptr_factory_.GetWeakPtr(), std::move(prepared), std::move(originals),
+      std::move(retiring), base::ScopedClosureRunner(drained)));
+}
+void WebBundleManager::DestroyRetiringFactory(
+    WebBundleURLLoaderFactory* expected) {
+  auto it = retiring_factories_.find(expected);
+  if (it != retiring_factories_.end())
+    retiring_factories_.erase(it);
+}
 
