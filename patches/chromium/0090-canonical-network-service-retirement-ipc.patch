+namespace {
+class PreparedNetworkServiceRetirement final
+    : public mojom::AlloyNetworkRetirement {
+ public:
+  PreparedNetworkServiceRetirement(
+      NetworkContext& context,
+      const net::AlloyNetworkRecordTarget& target) {
+    auto matches = base::BindRepeating(
+        [](net::AlloyNetworkRecordTarget target,
+           const NativeNetworkOwner& owner) {
+          if (target.Owns(owner.initiator))
+            return true;
+          if (owner.isolation_info && owner.isolation_info->frame_origin() &&
+              target.Owns(*owner.isolation_info->frame_origin()))
+            return true;
+          return target.DependsOnTransport(owner.network_key,
+                                           owner.destination);
+        },
+        target);
+    auto drained = base::BarrierClosure(
+        3, base::BindOnce(&PreparedNetworkServiceRetirement::OnNativeDrained,
+                          weak_factory_.GetWeakPtr()));
+    prepared_.push_back(
+        context.PrepareURLLoaderServiceRetirement(matches, drained));
+    prepared_.push_back(
+        context.PrepareTransportServiceRetirement(matches, drained));
+    prepared_.push_back(CommitNetworkRetirementOnDrop(
+        base::BindOnce([](base::ScopedClosureRunner finish) {},
+                       base::ScopedClosureRunner(drained))));
+  }
+  ~PreparedNetworkServiceRetirement() override {
+    weak_factory_.InvalidateWeakPtrs();
+    // Each native action is commit-on-drop. Its actual native work/callbacks
+    // still own their drain even when the requesting endpoint has gone away.
+    auto originals = std::move(prepared_);
+  }
+  void Commit(CommitCallback callback) override {
+    if (committed_) {
+      std::move(callback).Run(false);
+      return;
+    }
+    committed_ = true;
+    reply_ = std::move(callback);
+    // Outgoing notifications can reenter and destroy this operation/context.
+    // Move the complete original batch off-object before invoking anything.
+    auto originals = std::move(prepared_);
+    for (auto& commit : originals)
+      std::move(commit).Run();
+  }
+
+ private:
+  void OnNativeDrained() {
+    CHECK(committed_);
+    std::move(reply_).Run(true);
+  }
+  std::vector<base::OnceClosure> prepared_;
+  CommitCallback reply_;
+  bool committed_ = false;
+  base::WeakPtrFactory<PreparedNetworkServiceRetirement> weak_factory_{this};
+};
+}  // namespace
+
+void NetworkContext::PrepareAlloyNetworkServiceRetirement(
+    const std::string& record_domain,
+    mojo::PendingReceiver<mojom::AlloyNetworkRetirement> retirement,
+    PrepareAlloyNetworkServiceRetirementCallback callback) {
+  auto target =
+      net::AlloyNetworkRecordTarget::FromCanonicalDomain(record_domain);
+  if (!target || !retirement.is_valid()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  network_retirements_.Add(
+      std::make_unique<PreparedNetworkServiceRetirement>(*this, *target),
+      std::move(retirement));
+  std::move(callback).Run(true);
 }
 
