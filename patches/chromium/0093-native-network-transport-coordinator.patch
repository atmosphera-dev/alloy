+base::OnceClosure HttpNetworkSession::PrepareRecordTransportRetirement(
+    const AlloyNetworkRecordTarget& target,
+    base::OnceClosure done) {
+  // Cache/metadata admission closes before original job/socket cancellation can
+  // publish late state. Native user notifications stay in the commit actions.
+  ssl_client_session_cache_.FlushMatching(base::BindRepeating(
+      [](AlloyNetworkRecordTarget target,
+         const SSLClientSessionCache::Key& key) {
+        return target.DependsOnTransport(
+            key.network_anonymization_key,
+            url::SchemeHostPort(url::kHttpsScheme, key.server.host(),
+                                key.server.port())
+                .GetURL(),
+            key.session_usage);
+      },
+      target));
+  auto drained = base::BarrierClosure(
+      7, base::BindOnce(
+             [](base::OnceClosure done) {
+               base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+                   FROM_HERE, std::move(done));
+             },
+             std::move(done)));
+  std::vector<base::OnceClosure> prepared;
+  prepared.push_back(quic_session_pool_.PrepareNetworkRetirement(
+      base::BindRepeating(
+          [](AlloyNetworkRecordTarget target,
+             const NetworkAnonymizationKey& key,
+             const quic::QuicServerId& server, SessionUsage usage) {
+            return target.DependsOnTransport(
+                key,
+                url::SchemeHostPort(url::kHttpsScheme, server.host(),
+                                    server.port())
+                    .GetURL(),
+                usage);
+          },
+          target),
+      drained));
+  prepared.push_back(spdy_session_pool_.PrepareMatchingSessions(
+      base::BindRepeating(
+          [](AlloyNetworkRecordTarget target, const SpdySessionKey& key) {
+            return target.DependsOnTransport(
+                key.network_anonymization_key(),
+                url::SchemeHostPort(url::kHttpsScheme,
+                                    key.host_port_pair().host(),
+                                    key.host_port_pair().port())
+                    .GetURL(),
+                key.session_usage());
+          },
+          target),
+      drained));
+  prepared.push_back(http_stream_factory_->PrepareNetworkRetirement(
+      base::BindRepeating(
+          [](AlloyNetworkRecordTarget target,
+             const NetworkAnonymizationKey& key,
+             const url::SchemeHostPort& destination) {
+            return target.DependsOnTransport(key, destination.GetURL());
+          },
+          target),
+      drained));
+  if (http_stream_pool_)
+    prepared.push_back(http_stream_pool_->PrepareMatchingStreams(
+        base::BindRepeating(
+            [](AlloyNetworkRecordTarget target, const HttpStreamKey& key) {
+              return target.DependsOnTransport(key.network_anonymization_key(),
+                                               key.destination().GetURL());
+            },
+            target),
+        drained));
+  else
+    drained.Run();
+  prepared.push_back(
+      normal_socket_pool_manager_->PrepareTransportPoolRetirement(target,
+                                                                  drained));
+  prepared.push_back(
+      websocket_socket_pool_manager_->PrepareTransportPoolRetirement(target,
+                                                                     drained));
+  return CommitNetworkRetirementOnDrop(base::BindOnce(
+      [](std::vector<base::OnceClosure> originals,
+         base::ScopedClosureRunner finish) {
+        for (auto& commit : originals)
+          std::move(commit).Run();
+      },
+      std::move(prepared), base::ScopedClosureRunner(drained)));
+}
