+base::OnceClosure ClientSocketPoolManagerImpl::PrepareTransportPoolRetirement(
+    const AlloyNetworkRecordTarget& target,
+    base::OnceClosure done) {
+  std::vector<TransportClientSocketPool*> originals;
+  for (const auto& [proxy, pool] : socket_pools_) {
+    // This is the exact creation branch in GetSocketPool below. Native direct
+    // WebSocket lifetimes are in the context's prepared channel/factory batch.
+    if (pool_type_ == HttpNetworkSession::SocketPoolType::kWebSocket &&
+        proxy.is_direct())
+      continue;
+    originals.push_back(static_cast<TransportClientSocketPool*>(pool.get()));
+  }
+  auto drained = base::BarrierClosure(
+      originals.size() + 1,
+      base::BindOnce(
+          [](base::OnceClosure done) {
+            base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+                FROM_HERE, std::move(done));
+          },
+          std::move(done)));
+  auto matches = base::BindRepeating(
+      [](AlloyNetworkRecordTarget target,
+         const ClientSocketPool::GroupId& key) {
+        return target.DependsOnTransport(key.network_anonymization_key(),
+                                         key.destination().GetURL());
+      },
+      target);
+  std::vector<base::OnceClosure> prepared;
+  for (auto* pool : originals)
+    prepared.push_back(pool->PrepareMatchingGroups(matches, drained));
+  return CommitNetworkRetirementOnDrop(base::BindOnce(
+      [](std::vector<base::OnceClosure> originals,
+         base::ScopedClosureRunner finish) {
+        for (auto& commit : originals)
+          std::move(commit).Run();
+      },
+      std::move(prepared), base::ScopedClosureRunner(drained)));
 }
 
