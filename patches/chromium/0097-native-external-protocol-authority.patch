 bool ExternalProtocolHandler::MayRememberAllowDecisionsForThisOrigin(
+    const url::Origin* initiating_origin, Profile* profile) {
+  if (!initiating_origin || !network::IsOriginPotentiallyTrustworthy(*initiating_origin))
+    return false;
+  if (profile && (!ServiceCreationGate::Allows(*profile) || profile->ShutdownStarted()))
+    return false;
+  if (profile && alloy::site_records::RequestContextPolicy::Get(*profile)) {
+    if (alloy::site_records::RequestContextPolicy::IsStateless(*profile) ||
+        alloy::site_records::RecordDomainForPrincipal(
+            initiating_origin->GetURL(), *initiating_origin).empty()) return false;
+  }
+  return true;
+}
