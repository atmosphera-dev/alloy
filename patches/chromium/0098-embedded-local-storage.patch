 namespace content {
 
 namespace {
+
+// Only the trusted browser ForProcess entry points omit LocalFrameToken. A key
+// supplied there may resolve an existing active native frame, never mint scope
+// authority from its serialized nonce or fall back after retirement.
+RenderFrameHostImpl* FindStorageFrame(
+    ChildProcessId process_id,
+    StoragePartitionImpl* partition,
+    const blink::StorageKey& key) {
+  auto* process = RenderProcessHost::FromID(process_id);
+  if (!process || process->GetStoragePartition() != partition) {
+    return nullptr;
+  }
+  RenderFrameHostImpl* result = nullptr;
+  process->ForEachRenderFrameHost([&](RenderFrameHost* frame) {
+    if (frame->IsActive() && frame->GetStorageKey() == key &&
+        frame->GetStoragePartition() == partition) {
+      result = static_cast<RenderFrameHostImpl*>(frame);
+    }
+  });
+  return result;
+}
 
