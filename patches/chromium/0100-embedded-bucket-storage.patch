+  if (shut_down_ || (admission_ && !admission_.Run())) {
+    return;
+  }
   io_thread_->PostTask(
       FROM_HERE, base::BindOnce(&QuotaContext::BindQuotaManagerHostOnIOThread,
                                 this, storage_key, std::move(receiver)));
