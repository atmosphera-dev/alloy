+
+void QuotaContext::Shutdown() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  shut_down_ = true;
+  io_thread_->PostTask(FROM_HERE, base::BindOnce([](scoped_refptr<QuotaContext> owner) {
+    owner->receivers_.Clear();
+  }, base::WrapRefCounted(this)));
 }
 
