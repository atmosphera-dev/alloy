+void FileSystemAccessManagerImpl::ShutdownStorageScope() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(storage_admission_);
+  if (storage_shutdown_) { return; }
+  storage_shutdown_ = true;
+  weak_factory_.InvalidateWeakPtrs();
+  receivers_.Clear();
+  internals_receivers_.Clear();
+  writer_receivers_.clear();
+  access_handle_host_receivers_.clear();
+  file_receivers_.Clear();
+  directory_receivers_.Clear();
+  transfer_tokens_.clear();
+  data_transfer_tokens_.clear();
+  file_ids_.clear();
+  directory_ids_.clear();
 }
 
