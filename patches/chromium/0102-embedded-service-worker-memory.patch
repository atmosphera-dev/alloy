+bool ServiceWorkerContextWrapper::InitForEmbeddedMemoryScope(
+    StoragePartitionImpl& partition,
+    storage::QuotaManagerProxy* quota_manager_proxy,
+    ChromeBlobStorageContext* blob_context) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  using alloy::site_records::StorePurpose;
+  using alloy::site_records::StorageAccess;
+  if (storage_owner_.backing !=
+          alloy::site_records::EmbeddedStateRegistry::Backing::kTemporary ||
+      !storage_owner_.temporary) {
+    return false;
+  }
+  const auto capability = storage_owner_.temporary->Capability(StorePurpose::kServiceWorkers);
+  if (!capability.Allows(StorePurpose::kServiceWorkers, StorageAccess::kWriteMemory)) {
+    return false;
+  }
+  CHECK(!storage_partition_ && !context_core_);
+  set_storage_partition(&partition);
+  Init(base::FilePath(), quota_manager_proxy, nullptr, blob_context);
+  if (!capability.active()) {
+    Shutdown();
+    return false;
+  }
+  return true;
 }
 
