+bool ServiceWorkerClientOwner::TransferReservedClient(
+    ServiceWorkerClient& client, ServiceWorkerContextCore& new_context) {
+  CHECK(!client.is_response_committed());
+  CHECK(&client.owner() == this);
+  CHECK(!in_dtor_);
+  if (&new_context.service_worker_client_owner() == this) { return true; }
+  auto target = new_context.AsWeakPtr();
+  const auto uuid = client.client_uuid();
+  if (!client.RebindReservedStorageContext(
+          base::PassKey<ServiceWorkerClientOwner>(), target)) {
+    return false;
+  }
+  // Rebinding may invoke native controller callbacks. From here to insertion
+  // there are no callbacks; the target weak context has been revalidated.
+  auto found = service_worker_clients_by_uuid_.find(uuid);
+  CHECK(found != service_worker_clients_by_uuid_.end());
+  CHECK(found->second.get() == &client);
+  auto owned = std::move(found->second);
+  service_worker_clients_by_uuid_.erase(found);
+  auto& destination = target->service_worker_client_owner();
+  CHECK(destination.service_worker_clients_by_uuid_.emplace(uuid, std::move(owned)).second);
+  return true;
+}
