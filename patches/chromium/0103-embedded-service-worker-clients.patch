+bool ServiceWorkerClient::RebindReservedStorageContext(
+    base::PassKey<ServiceWorkerClientOwner>,
+    base::WeakPtr<ServiceWorkerContextCore> context) {
+  CHECK(!is_response_committed());
+  CHECK(!container_host_);
+  auto alive = AsWeakPtr();
+  SetControllerRegistration(nullptr, false);
+  if (!alive || !context) { return false; }
+  RemoveAllMatchingRegistrations();
+  if (!alive || !context) { return false; }
+  context_ = std::move(context);
+  owner_ = context_->service_worker_client_owner();
+  return true;
+}
+
+AlloyEmbeddedResolution ServiceWorkerClient::GetAlloyStorageOwnerForRequest(
+    const GURL& url) const {
+  if (!context_ || !context_->wrapper()->storage_partition()) { return {}; }
+  auto* partition = context_->wrapper()->storage_partition();
+  return std::visit(absl::Overload(
+      [&](GlobalRenderFrameHostId) -> AlloyEmbeddedResolution {
+        // Prefetch/download reserved clients have no live navigation node.
+        // Their browser-side creator supplies the captured context owner.
+        if (is_initiated_by_prefetch_ ||
+            ongoing_navigation_frame_tree_node_id_ == FrameTreeNodeId()) {
+          return context_->wrapper()->bucket_storage_owner();
+        }
+        auto* node = FrameTreeNode::GloballyFindByID(ongoing_navigation_frame_tree_node_id_);
+        auto* navigation = node ? node->navigation_request() : nullptr;
+        return navigation ? GetAlloyEmbeddedStateForNavigation(navigation, url::Origin::Create(url))
+                          : AlloyEmbeddedResolution();
+      },
+      [&](blink::DedicatedWorkerToken token) -> AlloyEmbeddedResolution {
+        auto* service = static_cast<DedicatedWorkerServiceImpl*>(partition->GetDedicatedWorkerService());
+        auto* host = service->GetDedicatedWorkerHostFromToken(token);
+        return host ? host->GetBucketStorageOwner() : AlloyEmbeddedResolution();
+      },
+      [&](blink::SharedWorkerToken token) -> AlloyEmbeddedResolution {
+        auto* service = static_cast<SharedWorkerServiceImpl*>(partition->GetSharedWorkerService());
+        auto* host = service->GetSharedWorkerHostFromToken(token);
+        return host ? host->GetBucketStorageOwner() : AlloyEmbeddedResolution();
+      }), client_info_);
+}
