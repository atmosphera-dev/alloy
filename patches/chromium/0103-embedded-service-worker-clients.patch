+bool ServiceWorkerMainResourceHandle::PrepareContextForRequest(const GURL& url) {
+  if (!service_worker_client() || !context_wrapper_->storage_partition()) { return false; }
+  auto alive = AsWeakPtr();
+  auto selected = GetAlloyServiceWorkerContextForOwner(
+      *context_wrapper_->storage_partition(),
+      service_worker_client()->GetAlloyStorageOwnerForRequest(url));
+  if (!alive) { return false; }
+  if (!selected || !selected->context() || !service_worker_client()) {
+    scoped_service_worker_client_.reset();
+    return false;
+  }
+  if (selected.get() != context_wrapper_.get()) {
+    auto client = service_worker_client();
+    const bool transferred = client->owner().TransferReservedClient(*client, *selected->context());
+    if (!alive) { return false; }
+    if (!transferred) {
+      scoped_service_worker_client_.reset();
+      return false;
+    }
+    if (!client) { return false; }
+    context_wrapper_ = std::move(selected);
+  }
+  return true;
+}
