+void NetworkContext::FlushPersistentStateForTesting(
+    FlushPersistentStateForTestingCallback callback) {
+  auto* prefs = url_request_context_owner_.pref_service.get();
+  if (!prefs) {
+    std::move(callback).Run();
+    return;
+  }
+  auto flush = base::BindOnce(
+      [](base::WeakPtr<NetworkContext> self,
+         FlushPersistentStateForTestingCallback callback) {
+        if (!self) {
+          return;
+        }
+        auto* properties = self->url_request_context_->http_server_properties();
+        // Initialization observers were registered during construction, before
+        // this setup request. Dispatch after that native observer batch; never
+        // use the testing flush to invalidate uninitialized startup properties.
+        CHECK(properties && properties->IsInitialized());
+        properties->FlushWritePropertiesForTesting(base::BindOnce(
+            [](base::WeakPtr<NetworkContext> self,
+               FlushPersistentStateForTestingCallback callback) {
+              if (self) {
+                self->url_request_context_owner_.pref_service
+                    ->CommitPendingWrite(std::move(callback));
+              }
+            },
+            self, std::move(callback)));
+      },
+      weak_factory_.GetWeakPtr(), std::move(callback));
+  if (prefs->GetInitializationStatus() ==
+      PrefService::INITIALIZATION_STATUS_WAITING) {
+    prefs->AddPrefInitObserver(base::BindOnce(
+        [](base::OnceClosure flush, bool success) {
+          CHECK(success);
+          base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+              FROM_HERE, std::move(flush));
+        },
+        std::move(flush)));
+  } else {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                             std::move(flush));
+  }
+}
