+void BlobStorageContext::RegisterFromBlob(
+    mojo::PendingReceiver<blink::mojom::Blob> blob,
+    mojo::PendingRemote<blink::mojom::Blob> source,
+    const std::string& content_type,
+    uint64_t size) {
+  if (!IsStorageAccessAllowed()) {
+    return;
+  }
+  mojo::Remote<blink::mojom::Blob> remote(std::move(source));
+  if (!storage_admission_) {
+    remote->Clone(std::move(blob));
+    return;
+  }
+  auto* input = remote.get();
+  input->ReadSideData(mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      base::BindOnce(
+          [](base::WeakPtr<BlobStorageContext> context,
+             mojo::Remote<blink::mojom::Blob> source,
+             mojo::PendingReceiver<blink::mojom::Blob> blob,
+             std::string content_type, uint64_t size,
+             std::optional<mojo_base::BigBuffer> side_data) {
+            if (!context || !context->IsStorageAccessAllowed()) {
+              return;
+            }
+            if (side_data &&
+                side_data->size() >
+                    static_cast<size_t>(std::numeric_limits<int>::max())) {
+              return;
+            }
+            auto builder = std::make_unique<BlobDataBuilder>(
+                base::Uuid::GenerateRandomV4().AsLowercaseString());
+            builder->set_content_type(content_type);
+            builder->AppendReadableDataHandle(
+                base::MakeRefCounted<RemoteBlobDataHandle>(
+                    source.Unbind(), size, side_data ? side_data->size() : 0));
+            BlobImpl::Create(context->AddFinishedBlob(std::move(builder)),
+                             std::move(blob));
+          },
+          AsWeakPtr(), std::move(remote), std::move(blob), content_type, size),
+      std::optional<mojo_base::BigBuffer>()));
+}
