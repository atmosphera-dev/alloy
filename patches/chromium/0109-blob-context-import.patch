+// A remote data source remains a dependency, not authority for the receiving
+// context. The native BlobDataHandle/BlobReader enforces the latter's
+// admission.
+class RemoteBlobReadCompletion final : public blink::mojom::BlobReaderClient {
+ public:
+  RemoteBlobReadCompletion(uint64_t size,
+                           uint64_t length,
+                           base::OnceCallback<void(int)> callback)
+      : size_(size),
+        length_(length),
+        callback_(
+            mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(callback),
+                                                        net::ERR_FAILED)) {}
+  void OnCalculatedSize(uint64_t total_size,
+                        uint64_t expected_content_size) override {
+    valid_size_ = total_size == size_ && expected_content_size == length_;
+  }
+  void OnComplete(int32_t status, uint64_t data_length) override {
+    if (callback_) {
+      std::move(callback_).Run(status == net::OK &&
+                                       (!valid_size_ || data_length != length_)
+                                   ? net::ERR_FAILED
+                                   : status);
+    }
+  }
+
+ private:
+  const uint64_t size_;
+  const uint64_t length_;
+  bool valid_size_ = false;
+  base::OnceCallback<void(int)> callback_;
+};
+
+class RemoteBlobDataHandle final : public BlobDataItem::DataHandle {
+ public:
+  RemoteBlobDataHandle(mojo::PendingRemote<blink::mojom::Blob> source,
+                       uint64_t size,
+                       uint64_t side_data_size)
+      : source_(std::move(source)),
+        size_(size),
+        side_data_size_(side_data_size) {}
+  uint64_t GetSize() const override { return size_; }
+  uint64_t GetSideDataSize() const override { return side_data_size_; }
+  void Read(mojo::ScopedDataPipeProducerHandle producer,
+            uint64_t offset,
+            uint64_t length,
+            base::OnceCallback<void(int)> callback) override {
+    mojo::PendingRemote<blink::mojom::BlobReaderClient> completion;
+    mojo::MakeSelfOwnedReceiver(std::make_unique<RemoteBlobReadCompletion>(
+                                    size_, length, std::move(callback)),
+                                completion.InitWithNewPipeAndPassReceiver());
+    source_->ReadRange(offset, length, std::move(producer),
+                       std::move(completion));
+  }
+  void ReadSideData(
+      base::OnceCallback<void(int, mojo_base::BigBuffer)> callback) override {
+    source_->ReadSideData(mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+        base::BindOnce(
+            [](base::OnceCallback<void(int, mojo_base::BigBuffer)> callback,
+               std::optional<mojo_base::BigBuffer> data) {
+              const int status =
+                  data && data->size() <= static_cast<size_t>(
+                                              std::numeric_limits<int>::max())
+                      ? static_cast<int>(data->size())
+                      : net::ERR_FAILED;
+              std::move(callback).Run(
+                  status, data ? std::move(*data) : mojo_base::BigBuffer());
+            },
+            std::move(callback)),
+        std::optional<mojo_base::BigBuffer>()));
+  }
+  void PrintTo(::std::ostream* os) const override {
+    *os << "<RemoteBlobDataHandle>";
+  }
+
+ private:
+  ~RemoteBlobDataHandle() override = default;
+  mojo::Remote<blink::mojom::Blob> source_;
+  const uint64_t size_;
+  const uint64_t side_data_size_;
+};
