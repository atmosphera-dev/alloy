+namespace {
+// Entry-key namespace only: this never discovers or selects a backend. Native
+// equality/order retains every site, opaque identity, nonce and partition.
+class MemoryCacheKeySpace {
+ public:
+  std::optional<std::string> Key(const NetworkIsolationKey& key) {
+    if (key.IsEmpty())
+      return std::nullopt;
+    if (!key.IsTransient())
+      return key.ToCacheKeyString();
+    auto found = identities_.find(key);
+    if (found == identities_.end()) {
+      // Bound metadata without evicting/reusing an existing identity. New
+      // identities at capacity simply miss, like a full native memory cache.
+      if (identities_.size() >= 16384)
+        return std::nullopt;
+      found = identities_.emplace(key, identities_.size() + 1).first;
+    }
+    return base::StrCat({"*memory*", base::NumberToString(found->second)});
+  }
+
+ private:
+  std::map<NetworkIsolationKey, uint64_t> identities_;
+};
+}  // namespace
