+std::optional<std::string> GeneratedCodeCache::GetCacheKeyForBackend(
+    const GURL& resource_url,
+    const GURL& origin_lock,
+    const net::NetworkIsolationKey& nik) {
+  if (backing_ == Backing::kDisk) {
+    // Keep the legacy empty-NIK contract, but never erase transient identity.
+    if (nik.IsTransient() && !nik.IsEmpty()) {
+      return std::nullopt;
+    }
+    return GetCacheKey(resource_url, origin_lock, nik, cache_type_);
+  }
+  auto it = memory_nik_prefixes_.find(nik);
+  if (it == memory_nik_prefixes_.end()) {
+    if (memory_nik_prefixes_.size() >= 16384) {
+      return std::nullopt;
+    }
+    const std::string prefix =
+        "memory-nik-" + std::to_string(memory_nik_prefixes_.size()) + "\n";
+    it = memory_nik_prefixes_.emplace(nik, prefix).first;
+  }
+  return GetCacheKey(resource_url, origin_lock, nik, cache_type_) + kSeparator +
+         it->second;
 }
 
