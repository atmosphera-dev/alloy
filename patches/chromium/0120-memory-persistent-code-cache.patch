+class MemoryBackendLifetime::State {
+ public:
+  base::Lock lock;
+  bool abandoned = false;
+  std::vector<sqlite_vfs::SharedLocks> locks;
+};
+MemoryBackendLifetime::MemoryBackendLifetime()
+    : state_(std::make_unique<State>()) {}
+MemoryBackendLifetime::~MemoryBackendLifetime() {
+  Abandon();
+}
+bool MemoryBackendLifetime::Register(
+    const base::UnsafeSharedMemoryRegion& region,
+    bool wal_mode) {
+  auto mapped = sqlite_vfs::SharedLocks::Create(region, wal_mode);
+  if (!mapped)
+    return false;
+  base::AutoLock lock(state_->lock);
+  if (state_->abandoned) {
+    mapped->Abandon();
+    return false;
+  }
+  // Evicted caches already abandon their own exports; do not retain their maps.
+  std::erase_if(state_->locks,
+                [](const auto& item) { return item.IsAbandoned(); });
+  state_->locks.push_back(std::move(*mapped));
+  return true;
+}
+void MemoryBackendLifetime::Abandon() {
+  base::AutoLock lock(state_->lock);
+  state_->abandoned = true;
+  for (auto& item : state_->locks)
+    item.Abandon();
+  state_->locks.clear();
+}
 
