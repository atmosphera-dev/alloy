+std::optional<std::string> GeneratedCodeCacheContext::ContextKeyForBacking(
+    std::string native_key,
+    const net::NetworkIsolationKey& nik,
+    bool wasm) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (is_shutdown())
+    return std::nullopt;
+  if (!memory_only_) {
+    if (nik.IsTransient() && !nik.IsEmpty())
+      return std::nullopt;
+    return native_key;
+  }
+  auto it = memory_namespaces_.find(nik);
+  if (it == memory_namespaces_.end()) {
+    if (memory_namespaces_.size() >= kMaxMemoryNamespaces)
+      return std::nullopt;
+    it = memory_namespaces_.emplace(nik, memory_namespaces_.size()).first;
+  }
+  return native_key + "\nmemory-nik-" + std::to_string(it->second) +
+         (wasm ? "/wasm" : "/js");
