+class TrialForwarder : public TrialDelegate {
+ public:
+  void AddObserver(Observer* observer) override {
+    if (auto* n = Native())
+      n->AddObserver(observer);
+  }
+  void RemoveObserver(Observer* observer) override {
+    if (auto* n = RemovalTarget())
+      n->RemoveObserver(observer);
+  }
+  void PersistTrialsFromTokens(const url::Origin& origin,
+                               const url::Origin& partition,
+                               base::span<const std::string> tokens,
+                               base::Time time,
+                               std::optional<ukm::SourceId> id) override {
+    if (auto* n = Native())
+      n->PersistTrialsFromTokens(origin, partition, tokens, time, id);
+  }
+  void PersistAdditionalTrialsFromTokens(
+      const url::Origin& origin,
+      const url::Origin& partition,
+      base::span<const url::Origin> scripts,
+      base::span<const std::string> tokens,
+      base::Time time,
+      std::optional<ukm::SourceId> id) override {
+    if (auto* n = Native())
+      n->PersistAdditionalTrialsFromTokens(origin, partition, scripts, tokens,
+                                           time, id);
+  }
+  bool IsFeaturePersistedForOrigin(const url::Origin& origin,
+                                   const url::Origin& partition,
+                                   blink::mojom::OriginTrialFeature feature,
+                                   base::Time time) override {
+    auto* n = Native();
+    return n &&
+           n->IsFeaturePersistedForOrigin(origin, partition, feature, time);
+  }
+  base::flat_set<std::string> GetPersistedTrialsForOrigin(
+      const url::Origin& origin,
+      const url::Origin& partition,
+      base::Time time) override {
+    auto* n = Native();
+    return n ? n->GetPersistedTrialsForOrigin(origin, partition, time)
+             : base::flat_set<std::string>();
+  }
+  void ClearPersistedTokens() override {
+    if (auto* n = Native())
+      n->ClearPersistedTokens();
+  }
+
+ protected:
+  virtual origin_trials::OriginTrials* Native() = 0;
+  virtual origin_trials::OriginTrials* RemovalTarget() = 0;
+};
+
+class ScopedTrialLease final : public TrialForwarder {
+ public:
+  explicit ScopedTrialLease(TrialCapability capability)
+      : capability_(std::move(capability)) {
+    if (capability_.Allows(TrialPurpose::kOriginTrials,
+                           alloy::site_records::StorageAccess::kWriteMemory)) {
+      native_ = std::make_unique<origin_trials::OriginTrials>(
+          origin_trials::LevelDbPersistenceProvider::CreateInMemory(),
+          std::make_unique<blink::TrialTokenValidator>());
+    }
+  }
+  ~ScopedTrialLease() override { Close(); }
+  bool IsStateAdmissionOpen() const override {
+    return !closed_ && native_ &&
+           capability_.Allows(TrialPurpose::kOriginTrials,
+                              alloy::site_records::StorageAccess::kWriteMemory);
+  }
+  void Close() {
+    if (closed_)
+      return;
+    closed_ = true;
+    if (native_)
+      native_->ClearPersistedTokens();
+    native_.reset();
+  }
+
+ protected:
+  origin_trials::OriginTrials* Native() override {
+    return IsStateAdmissionOpen() ? native_.get() : nullptr;
+  }
+  origin_trials::OriginTrials* RemovalTarget() override {
+    return native_.get();
+  }
+
+ private:
+  const TrialCapability capability_;
+  bool closed_ = false;
+  std::unique_ptr<origin_trials::OriginTrials> native_;
+};
+
+std::shared_ptr<TrialDelegate> ClosedTrialLease() {
+  static const base::NoDestructor<std::shared_ptr<TrialDelegate>> closed(
+      std::make_shared<ScopedTrialLease>(TrialCapability()));
+  return *closed;
+}
+
+class ScopedTrialService final : public KeyedService {
+ public:
+  explicit ScopedTrialService(TrialCapability capability)
+      : lease_(std::make_shared<ScopedTrialLease>(std::move(capability))) {}
+  ~ScopedTrialService() override { Shutdown(); }
+  void Shutdown() override {
+    if (lease_)
+      lease_->Close();
+  }
+  std::shared_ptr<TrialDelegate> lease() const { return lease_; }
+
+ private:
+  std::shared_ptr<ScopedTrialLease> lease_;
+};
+
+// The global factory publishes a routing facade without opening a Profile DB.
+// Only a real ordinary operation constructs the ordinary native controller.
+class AlloyOriginTrialsRoot final : public KeyedService, public TrialForwarder {
+ public:
+  explicit AlloyOriginTrialsRoot(content::BrowserContext* context)
+      : context_(context) {}
+  bool IsStateAdmissionOpen() const override {
+    return !context_->ShutdownStarted() &&
+           !alloy::site_records::RequestContextPolicy::IsStateless(*context_);
+  }
+  std::shared_ptr<TrialDelegate> GetForStateOwner(
+      std::optional<base::WeakPtr<base::SupportsUserData>> owner) override {
+    if (!IsStateAdmissionOpen())
+      return ClosedTrialLease();
+    if (!owner)
+      return std::shared_ptr<TrialDelegate>(this, [](TrialDelegate*) {});
+    auto selected = content::AlloyEmbeddedStateForStateOwner(*owner, context_);
+    if (selected.temporary) {
+      static const char kTrialService = 0;
+      auto* service = static_cast<ScopedTrialService*>(
+          selected.temporary->GetOrCreateService(
+              &kTrialService, TrialPurpose::kOriginTrials,
+              base::BindOnce([](TrialCapability capability)
+                                 -> std::unique_ptr<KeyedService> {
+                return std::make_unique<ScopedTrialService>(
+                    std::move(capability));
+              })));
+      return service ? service->lease() : ClosedTrialLease();
+    }
+    if (selected.temporary_admission_closed ||
+        selected.backing !=
+            alloy::site_records::EmbeddedStateRegistry::Backing::kRealSite) {
+      return ClosedTrialLease();
+    }
+    return std::shared_ptr<TrialDelegate>(this, [](TrialDelegate*) {});
+  }
+
+ protected:
+  origin_trials::OriginTrials* Native() override {
+    if (!IsStateAdmissionOpen())
+      return nullptr;
+    if (!ordinary_) {
+      const auto* policy =
+          alloy::site_records::RequestContextPolicy::Get(*context_);
+      const bool memory =
+          context_->IsOffTheRecord() ||
+          (policy &&
+           policy->storage_mode() == alloy::site_records::StorageMode::kMemory);
+      std::unique_ptr<origin_trials::OriginTrialsPersistenceProvider> provider;
+      if (memory)
+        provider = origin_trials::LevelDbPersistenceProvider::CreateInMemory();
+      else
+        provider = std::make_unique<origin_trials::LevelDbPersistenceProvider>(
+            context_->GetPath(),
+            context_->GetDefaultStoragePartition()->GetProtoDatabaseProvider());
+      ordinary_ = std::make_unique<origin_trials::OriginTrials>(
+          std::move(provider), std::make_unique<blink::TrialTokenValidator>());
+    }
+    return ordinary_.get();
+  }
+  origin_trials::OriginTrials* RemovalTarget() override {
+    return ordinary_.get();
+  }
+
+ private:
+  const raw_ptr<content::BrowserContext> context_;
+  std::unique_ptr<origin_trials::OriginTrials> ordinary_;
+};
