-  return GetChooserContext(frame)->AddPortObserver(observer);
+  auto* context = GetChooserContext(frame);
+  if (!context)
+    return;
+  CHECK(observations_.try_emplace(observer, context->AsWeakPtr()).second);
+  context->AddPortObserver(observer);
 }
 
 void ChromeSerialDelegate::RemoveObserver(content::RenderFrameHost* frame,
                                           Observer* observer) {
-  return GetChooserContext(frame)->RemovePortObserver(observer);
+  // Cleanup consumes the original registration, not current admission. The
+  // registered context can still be alive after its document has retired.
+  auto found = observations_.find(observer);
+  if (found == observations_.end())
+    return;
+  auto original = std::move(found->second);
+  observations_.erase(found);
+  if (original)
+    original->RemovePortObserver(observer);
 }
