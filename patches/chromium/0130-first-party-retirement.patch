+bool HttpCache::CacheKeyReferencesRecord(std::string_view key,
+                                        std::string_view record_domain,
+                                        bool partition_only) {
+  if (record_domain.empty()) return false;
+  auto owns = [record_domain](std::string_view text) {
+    const GURL url(text);
+    return AlloyRecordDomainForPrincipal(url, url::Origin::Create(url)) == record_domain;
+  };
+  if (!partition_only && owns(GetResourceURLFromHttpCacheKey(key))) return true;
+  // Parse beside the native key generator, never in a browser-side observer.
+  auto pos = key.find('/');
+  if (pos == std::string_view::npos) return false;
+  pos = key.find('/', pos + 1);
+  if (pos == std::string_view::npos) return false;
+  key.remove_prefix(pos + 1);
+  if (!key.starts_with(kDoubleKeyPrefix)) return false;
+  key.remove_prefix(strlen(kDoubleKeyPrefix));
+  if (key.starts_with(kSubframeDocumentResourcePrefix))
+    key.remove_prefix(strlen(kSubframeDocumentResourcePrefix));
+  if (key.starts_with(kCrossSiteMainFrameNavigationPrefix))
+    key.remove_prefix(strlen(kCrossSiteMainFrameNavigationPrefix));
+  auto sites = base::SplitStringPiece(key, kDoubleKeySeparator,
+                                     base::KEEP_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (!partition_only && !sites.empty()) sites.pop_back();
+  for (const auto site : sites) if (owns(site)) return true;
+  return false;
+}
