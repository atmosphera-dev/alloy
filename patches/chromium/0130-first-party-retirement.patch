+      retired.push_back(std::move(it->second)); it = cdm_files_.erase(it);
+    } else ++it;
+  }
+  retired.clear();
+  // Earlier writes are ordered before this delete on the native DB sequence.
+  DeleteData(base::BindRepeating(
+      [](net::AlloyNetworkRecordTarget target, const blink::StorageKey& key) {
+        return target.Owns(key.origin());
+      }, *target), blink::StorageKey(), base::Time(), base::Time::Max(),
+      std::move(callback));
