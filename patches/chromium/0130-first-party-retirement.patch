+    if (owns(*it)) it = servers_requiring_http_11_.Erase(it); else ++it;
+  }
+  for (auto it = quic_server_info_map_.begin(); it != quic_server_info_map_.end();) {
+    if (owns_quic(it->first)) it = quic_server_info_map_.Erase(it); else ++it;
