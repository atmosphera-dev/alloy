+void CdmStorageManager::RetireAlloyRecord(
+    const std::string& domain, base::OnceCallback<void(bool)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const auto target = net::AlloyNetworkRecordTarget::FromCanonicalDomain(domain);
+  if (!target) { std::move(callback).Run(false); return; }
+  // A pending EnsureOpen reply must retain its original receiver identity;
+  // disconnecting it also prevents a delayed open from creating a new file.
+  for (const auto& [id, context] : receivers_.GetAllContexts())
+    if (target->Owns(context->storage_key.origin())) receivers_.Remove(id);
