+void ReportingCacheImpl::RetireAlloyRecord(const std::string& domain) {
+  const auto target = AlloyNetworkRecordTarget::FromCanonicalDomain(domain);
+  CHECK(target);
+  // V0 clients have their own typed NAK/origin. An endpoint reference alone
+  // removes that endpoint, not the unrelated client's remaining configuration.
+  for (auto it = clients_.begin(); it != clients_.end();) {
+    if (target->DependsOnTransport(it->second.network_anonymization_key,
+                                   it->second.origin.GetURL()))
+      it = RemoveClientInternal(it);
+    else ++it;
+  }
+  std::set<GURL> endpoint_urls;
+  for (const auto& [key, endpoint] : endpoints_)
+    if (target->Owns(url::Origin::Create(endpoint.info.url)))
+      endpoint_urls.insert(endpoint.info.url);
+  for (const auto& url : endpoint_urls) RemoveEndpointsForUrl(url);
+
+  std::set<base::UnguessableToken> sources;
+  std::set<url::Origin> changed_origins;
+  for (auto it = document_endpoints_.begin(); it != document_endpoints_.end();) {
+    auto& endpoints = it->second;
+    CHECK(!endpoints.empty());
+    const auto& key = endpoints.front().group_key;
+    CHECK(key.origin);
+    const auto origin = *key.origin;
+    const bool owned = target->DependsOnTransport(key.network_anonymization_key,
+                                                 origin.GetURL());
+    const auto removed = std::erase_if(endpoints, [&](const ReportingEndpoint& endpoint) {
+      return owned || target->Owns(url::Origin::Create(endpoint.info.url));
+    });
+    if (removed) changed_origins.insert(origin);
+    if (endpoints.empty()) {
+      sources.insert(it->first);
+      isolation_info_.erase(it->first);
+      expired_sources_.erase(it->first);
+      it = document_endpoints_.erase(it);
+    } else ++it;
+  }
+  std::vector<raw_ptr<const ReportingReport, VectorExperimental>> removed_reports;
+  for (const auto& report : reports_)
+    if (target->DependsOnTransport(report->network_anonymization_key, report->url) ||
+        (report->reporting_source && sources.contains(*report->reporting_source)))
+      removed_reports.push_back(report.get());
+  // Native removal marks pending deliveries doomed until their owners drain.
+  RemoveReports(removed_reports);
+  for (const auto& origin : changed_origins)
+    context_->NotifyEndpointsUpdatedForOrigin(FilterEndpointsByOrigin(document_endpoints_, origin));
+  ConsistencyCheckClients();
+  context_->NotifyCachedClientsUpdated();
+  Flush();
+}
