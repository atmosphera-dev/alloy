+void SessionStorageImpl::RetireStorage(const blink::StorageKey& storage_key,
+                                      RetireStorageCallback callback) {
+  if (connection_state_ != CONNECTION_FINISHED) {
+    RunWhenConnected(base::BindOnce(&SessionStorageImpl::RetireStorage,
+        weak_ptr_factory_.GetWeakPtr(), storage_key, std::move(callback)));
+    return;
+  }
+  // Delayed renderer Clone messages travel on another pipe. Materialize all
+  // pending clones first so they cannot recreate deleted metadata afterwards.
+  for (const auto& [id, owner] : namespaces_) {
+    if (owner->HasChildNamespacesWaitingForClone())
+      owner->CloneAllNamespacesWaitingForClone(database_.get(), &metadata_, namespaces_);
+  }
+  for (const auto& [id, owner] : namespaces_) owner->RetireStorageKeyArea(storage_key);
+  std::vector<std::string> sessions;
+  for (const auto& [id, keys] : metadata_.namespace_storage_key_map()) {
+    if (keys.contains(storage_key)) sessions.push_back(id);
+  }
+  auto success = std::make_shared<bool>(true);
+  auto complete = base::BarrierClosure(sessions.size(), base::BindOnce(
+      [](std::shared_ptr<bool> success, RetireStorageCallback callback) {
+        std::move(callback).Run(*success);
+      }, success, std::move(callback)));
+  for (const auto& id : sessions) {
+    auto locator = metadata_.TakeExistingMap(id, storage_key);
+    if (!locator || !database_) { complete.Run(); continue; }
+    std::vector<DomStorageDatabase::MapLocator> maps;
+    if (locator->session_ids().empty()) maps.emplace_back(std::move(*locator));
+    database_->DeleteStorageKeysFromSession(id, {storage_key}, std::move(maps),
+        base::BindOnce([](std::shared_ptr<bool> success, base::OnceClosure complete,
+                          DbStatus status) {
+          *success = *success && status.ok(); std::move(complete).Run();
+        }, success, complete));
+  }
+}
