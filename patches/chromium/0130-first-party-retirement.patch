+        bool success = initialized && !self->has_shutdown_.load(std::memory_order_relaxed);
+        if (success) {
+          auto status = self->database_->ForEachNotificationData(base::BindRepeating(
+              [](net::AlloyNetworkRecordTarget target, std::set<GURL>* origins,
+                 const NotificationDatabaseData& data) {
+                if (target.Owns(url::Origin::Create(data.origin))) origins->insert(data.origin);
+              }, target, &origins));
+          success = status == NotificationDatabase::STATUS_OK;
+          for (const auto& origin : origins) {
+            if (!success) break;
+            status = self->database_->DeleteAllNotificationDataForOrigin(
+                origin, {}, std::nullopt, &removed);
+            success = status == NotificationDatabase::STATUS_OK;
+          }
+        }
+        // Unlike ordinary browsing-data cleanup, corruption is an error, not
+        // permission to raze another site's database and acknowledge success.
+        GetUIThreadTaskRunner({})->PostTask(FROM_HERE, base::BindOnce(
+            [](scoped_refptr<PlatformNotificationContextImpl> self,
+               DeleteAllResultCallback callback, bool success,
+               std::set<std::string> removed) {
+              if (!removed.empty()) self->CloseNotifications(removed);
+              std::move(callback).Run(success, removed.size());
+            }, self, std::move(callback), success, std::move(removed)));
+      }, base::WrapRefCounted(this), *target, std::move(callback)));
+}
