+void HistoryService::RetireAlloyRecord(const std::string& domain,
+                                      base::OnceCallback<void(bool)> callback) {
+  const auto target = net::AlloyNetworkRecordTarget::FromCanonicalDomain(domain);
+  auto reply = std::make_shared<base::OnceCallback<void(bool)>>(
+      base::BindPostTaskToCurrentDefault(std::move(callback)));
+  if (!target || !backend_runner_ || !history_backend_) {
+    std::move(*reply).Run(false); return;
+  }
+  base::ScopedClosureRunner failed(base::BindOnce(
+      [](std::shared_ptr<base::OnceCallback<void(bool)>> reply) {
+        if (*reply) std::move(*reply).Run(false);
+      }, reply));
+  ScheduleDBTaskForUI(base::BindOnce(
+      [](net::AlloyNetworkRecordTarget target,
+         std::shared_ptr<base::OnceCallback<void(bool)>> reply,
+         base::ScopedClosureRunner failed, HistoryBackend* backend, URLDatabase* db) {
+        if (!backend || !db) return;
+        std::vector<GURL> urls;
+        URLRow row;
+        {
+          URLDatabase::URLEnumerator entries;
+          if (!db->InitURLEnumeratorForEverything(&entries)) return;
+          while (entries.GetNextURL(&row))
+            if (target.Owns(url::Origin::Create(row.url()))) urls.push_back(row.url());
+        }
+        // DeleteURLs commits and notifies the main-thread history/visited-link
+        // owners, and deletes now-unreferenced native favicon mappings/bytes.
+        if (!urls.empty()) backend->DeleteURLs(urls);
+        URLDatabase::URLEnumerator remaining;
+        bool success = db->InitURLEnumeratorForEverything(&remaining);
+        while (success && remaining.GetNextURL(&row))
+          if (target.Owns(url::Origin::Create(row.url()))) success = false;
+        success = backend->RetireAlloyFaviconMappings(target.domain()) && success;
+        std::move(*reply).Run(success);
+      }, *target, reply, std::move(failed)));
+}
