+bool HistoryBackend::RetireAlloyFaviconMappings(const std::string& domain) {
+  if (!favicon_backend_) return true;
+  const auto target = net::AlloyNetworkRecordTarget::FromCanonicalDomain(domain);
+  if (!target) return false;
+  // Favicon mappings can exist without a History URL row. Enumerate the
+  // native mapping catalogue as well, not only the visited-page catalogue.
+  auto* db = favicon_backend_->db();
+  for (const auto type : {favicon_base::IconType::kFavicon,
+                          favicon_base::IconType::kTouchIcon,
+                          favicon_base::IconType::kTouchPrecomposedIcon,
+                          favicon_base::IconType::kWebManifestIcon}) {
+    base::flat_set<GURL> pages;
+    {
+      favicon::FaviconDatabase::IconMappingEnumerator entries;
+      if (!db->InitIconMappingEnumerator(type, &entries)) return false;
+      favicon::IconMapping mapping;
+      while (entries.GetNextIconMapping(&mapping))
+        if (target->Owns(url::Origin::Create(mapping.page_url))) pages.insert(mapping.page_url);
+    }
+    if (!pages.empty()) DeleteFaviconMappings(pages, type);
+    favicon::FaviconDatabase::IconMappingEnumerator remaining;
+    if (!db->InitIconMappingEnumerator(type, &remaining)) return false;
+    favicon::IconMapping mapping;
+    while (remaining.GetNextIconMapping(&mapping))
+      if (target->Owns(url::Origin::Create(mapping.page_url))) return false;
+  }
+  favicon_backend_->Commit();
+  return true;
+}
