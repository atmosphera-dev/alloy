+void NetworkContext::RetireAlloyRecordData(const std::string& record_domain,
+                                          RetireAlloyRecordDataCallback callback) {
+  auto target = net::AlloyNetworkRecordTarget::FromCanonicalDomain(record_domain);
+  if (!target) { std::move(callback).Run(false); return; }
+  // Close retained script-cookie endpoints before touching the jar. All older
+  // CookieMonster operations are ordered before DeleteCookies on its sequence.
+  for (auto it = restricted_cookie_managers_.begin(); it != restricted_cookie_managers_.end();) {
+    if ((*it)->BelongsToAlloyRecord(*target)) it = restricted_cookie_managers_.erase(it);
+    else ++it;
+  }
+  auto filter = mojom::ClearDataFilter::New();
+  filter->type = mojom::ClearDataFilter_Type::DELETE_MATCHES;
+  filter->domains.push_back(record_domain);
+  auto success = std::make_shared<bool>(true);
+  auto finished = base::BarrierClosure(11, base::BindOnce(
+      [](std::shared_ptr<bool> success, RetireAlloyRecordDataCallback callback) {
+        std::move(callback).Run(*success);
+      }, success, std::move(callback)));
+  auto cookies = mojom::CookieDeletionFilter::New();
+  cookies->including_domains = std::vector<std::string>{record_domain};
+  cookie_manager_->DeleteCookies(std::move(cookies), base::IgnoreArgs<uint32_t>(finished));
+  for (const auto* scheme : {"http://", "https://"}) {
+    auto partition = mojom::CookieDeletionFilter::New();
+    partition->partitioned_state_only = true;
+    partition->cookie_partition_key_collection = net::CookiePartitionKeyCollection::MatchesSite(
+        net::SchemefulSite(GURL(base::StrCat({scheme, record_domain}))));
+    cookie_manager_->DeleteCookies(std::move(partition), base::IgnoreArgs<uint32_t>(finished));
+  }
+  http_cache_data_removers_.push_back(HttpCacheDataRemover::CreateAndStart(
+      url_request_context_, filter.Clone(), base::Time(), base::Time::Max(),
+      base::BindOnce([](NetworkContext* self, std::shared_ptr<bool> success,
+                        base::OnceClosure finished, HttpCacheDataRemover* remover) {
+        *success = *success && remover->success();
+        self->OnHttpCacheCleared(std::move(finished), remover);
+      }, base::Unretained(this), success, finished), record_domain));
+  url_request_context_->transport_security_state()->RetireAlloyRecord(record_domain);
+  url_request_context_->http_server_properties()->RetireAlloyRecord(record_domain, finished);
+#if BUILDFLAG(ENABLE_REPORTING)
+  auto report_result = base::BindRepeating(
+      [](std::shared_ptr<bool> success, base::RepeatingClosure finished, bool ok) {
+        *success = *success && ok; finished.Run();
+      }, success, finished);
+  if (auto* reporting = url_request_context_->reporting_service())
+    reporting->RetireAlloyRecord(record_domain, report_result);
+  else finished.Run();
+  if (auto* nel = url_request_context_->network_error_logging_service())
+    nel->RetireAlloyRecord(record_domain, report_result);
+  else finished.Run();
+#else
+  finished.Run(); finished.Run();
+#endif
+  ClearCorsPreflightCache(filter.Clone(), finished);
+  if (auto* session = url_request_context_->http_transaction_factory()->GetSession()) {
+    session->http_auth_cache()->ClearMatching(base::BindRepeating(
+        [](net::AlloyNetworkRecordTarget target, const url::SchemeHostPort& server,
+           net::HttpAuth::Target role, const net::NetworkAnonymizationKey& key) {
+          return role == net::HttpAuth::AUTH_SERVER && target.DependsOnTransport(key, server.GetURL());
+        }, *target));
+    session->ssl_client_context()->ClearClientCertificatesMatching(base::BindRepeating(
+        [](net::AlloyNetworkRecordTarget target, const net::HostPortPair& server) {
+          return target.Owns(url::Origin::Create(
+              url::SchemeHostPort("https", server.host(), server.port()).GetURL()));
+        }, *target));
+  }
+  finished.Run();
+  if (auto* hosts = url_request_context_->host_resolver()->GetHostCache())
+    hosts->ClearMatching(base::BindRepeating(
+        [](net::AlloyNetworkRecordTarget target, const net::HostCache::Key& key) {
+          const auto destination = std::holds_alternative<url::SchemeHostPort>(key.host)
+              ? std::get<url::SchemeHostPort>(key.host).GetURL()
+              : url::SchemeHostPort("https", std::get<std::string>(key.host), 443).GetURL();
+          return target.DependsOnTransport(key.network_anonymization_key, destination);
+        }, *target));
+  finished.Run();
+  ClearSharedDictionaryCache(base::Time(), base::Time::Max(), std::move(filter), finished);
+}
