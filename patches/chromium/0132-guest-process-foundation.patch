+    const char* bootstrap = getenv("ALLOY_GUEST_BOOTSTRAP");
+    const bool runtime_entry = bootstrap &&
+        std::find(argv.begin(), argv.end(), bootstrap) != argv.end();
+    if (runtime_entry) {
+      std::string manifest;
+      for (const auto& mapping : options.fds_to_remap) {
+        if (mapping.second >= ALLOY_GUEST_REGISTRATION_FD &&
+            mapping.second <= ALLOY_GUEST_RESOURCE_FD) {
+          return Process();
+        }
+        if (!manifest.empty()) manifest += ",";
+        manifest += NumberToString(mapping.second);
+      }
+      for (int fd : options.fds_to_remove_cloexec) {
+        if (!manifest.empty()) manifest += ",";
+        manifest += NumberToString(fd);
+      }
+      options.fds_to_remap.emplace_back(ALLOY_GUEST_REGISTRATION_FD,
+                                        ALLOY_GUEST_REGISTRATION_FD);
+      options.fds_to_remove_cloexec.push_back(ALLOY_GUEST_REGISTRATION_FD);
+      options.environment["ALLOY_GUEST_PRESERVE_FDS"] = manifest;
+    }
+  }
+#endif
