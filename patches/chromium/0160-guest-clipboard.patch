+void ClipboardHostImpl::PrepareRead(ui::ClipboardBuffer buffer,
+    base::OnceCallback<void(ClipboardHostImpl*)> ready) {
+  if (!guest_clipboard_) { std::move(ready).Run(this); return; }
+  guest_clipboard_->RefreshSequence(buffer, base::BindOnce(
+      [](base::WeakPtr<ClipboardHostImpl> host,
+          base::OnceCallback<void(ClipboardHostImpl*)> ready, bool valid) {
+        if (!valid || !host) { std::move(ready).Run(nullptr); return; }
+        const bool active = host->context_->IsActive();
+        std::move(ready).Run(active && host ? host.get() : nullptr);
+      }, weak_ptr_factory_.GetWeakPtr(), std::move(ready)));
+}
+
+ui::Clipboard* ClipboardHostImpl::GetClipboard() {
+  return guest_clipboard_ ? guest_clipboard_.get()
+                          : ui::Clipboard::GetForCurrentThread();
+}
