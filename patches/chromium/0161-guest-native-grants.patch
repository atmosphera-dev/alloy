+HostContentSettingsMap* HostContentSettingsMapFactory::GetForNativeIntegration(
+    content::RenderFrameHost* frame) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!content::AlloyDocumentStateAdmitted(frame)) return nullptr;
+  if (UsesScopedSettings(frame)) return GetForFrame(frame);
+  return &AlloyDocumentSettings::GetOrCreateForCurrentDocument(frame)->settings->settings();
+}
