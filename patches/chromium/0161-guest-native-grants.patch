+KeyedService* HostContentSettingsMapFactory::GetNativeIntegrationDocumentService(
+    content::RenderFrameHost* frame, const void* key,
+    base::OnceCallback<std::unique_ptr<KeyedService>(HostContentSettingsMap*)> factory) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!content::AlloyDocumentStateAdmitted(frame)) return nullptr;
+  if (UsesScopedSettings(frame))
+    return GetStatelessDocumentService(frame, key, std::move(factory));
+  return AlloyDocumentSettings::GetOrCreateForCurrentDocument(frame)->settings->GetOrCreateService(
+      key, std::move(factory));
