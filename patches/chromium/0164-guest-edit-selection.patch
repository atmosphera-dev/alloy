+WebRange WebLocalFrameImpl::SelectionRangeForRestoration() const {
+  GetFrame()->GetDocument()->UpdateStyleAndLayout(DocumentUpdateReason::kSelection);
+  const auto selection = GetFrame()->Selection().ComputeVisibleSelectionInDomTree();
+  const auto range = selection.ToNormalizedEphemeralRange();
+  if (range.IsNull()) return WebRange();
+  ContainerNode* scope = selection.RootEditableElement();
+  if (!scope) scope = GetFrame()->GetDocument()->documentElement();
+  return scope ? WebRange(PlainTextRange::Create(*scope, range)) : WebRange();
+}
