+  guest_serialized_scope_ = handle_state_.guest_binding->OnRetired(base::BindOnce(
+      [](base::WeakPtr<FileSystemAccessTransferTokenImpl> token) {
+        if (!token) return;
+        token->guest_serialized_pin_ = false; token->guest_serialized_scope_ = {};
+        if (token->receivers_.empty()) token->manager_->RemoveToken(token->token_);
+      }, guest_weak_.GetWeakPtr()));
+  return true;
