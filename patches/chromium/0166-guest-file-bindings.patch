+bool FileSystemAccessTransferTokenImpl::PinForGuestSerialization() {
+  if (!handle_state_.guest_file || !handle_state_.guest_file->Admitted() ||
+      !handle_state_.guest_binding || !handle_state_.guest_binding->Admitted()) return false;
+  if (guest_serialized_pin_) return true;
