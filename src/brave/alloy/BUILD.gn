import("//brave/alloy/data/files.gni")

source_set("data_paths") {
  sources = [ "bundled_data.h" ]
  public_deps = [ "//base" ]
}

alloy_data_targets = []
foreach(source, alloy_data_files) {
  relative = rebase_path(source, "//brave/alloy/data")
  name = "data_" + string_replace(relative, "/", "_")
  copy(name) {
    sources = [ source ]
    outputs = [ "$root_out_dir/alloy-data/$relative" ]
  }
  alloy_data_targets += [ ":$name" ]
}

group("bundled_data") {
  deps = alloy_data_targets
}

group("site_records_tests") {
  testonly = true
  deps = [ "site_records:alloy_site_records_unittests" ]
}

group("navigation_mock_tests") {
  testonly = true
  deps = [ "navigation_mock:alloy_navigation_mock_unittests" ]
}

group("alloy_api_test_support") {
  testonly = true
  deps = [
    "api_compatibility:alloy_api_compatibility_unittests",
    "navigation_mock:alloy_navigation_mock_unittests",
    "//brave/browser/renderer_context_menu/test:unit_tests",
    "//brave/browser/ui/views/frame:unit_tests",
    "//chrome/browser/apps/platform_apps:browser_tests",
    "//chrome/browser/ui/browser_window/test:test_support",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//chrome/test/base:chrome_unit_test_suite",
    "//components/viz/test:test_support",
    "//content/test:test_support",
    "//device/bluetooth:mocks",
    "//net/dns:tests",
    "//services/device/public/cpp:test_support",
    "//services/network:test_support",
  ]
}
