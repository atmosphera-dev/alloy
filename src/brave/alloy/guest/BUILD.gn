import("//testing/test.gni")

_implementation = [
  "bootstrap/main.c", "bootstrap/supervisor.c", "bootstrap/engine_main.cc",
  "session/session.cc", "session/session.h", "session/client.cc", "session/client.h",
  "session/supervisor.cc", "session/supervisor.h", "session/host.cc",
  "session/control_queue.h",
  "session/extensions.h", "session/extensions.cc",
  "session/interactions.h", "session/interactions.cc",
  "stream/resource_lane.h", "stream/resource_lane.cc",
  "stream/frame_pool.h", "stream/frame_pool.cc",
  "stream/lease.h", "stream/lease.cc", "stream/stream_client.h", "stream/stream_client.cc",
  "stream/view.h", "stream/view.cc",
  "session/view_adoption.h", "stream/input.h", "stream/input.cc",
  "stream/interaction.h", "stream/interaction.cc", "stream/popup.h", "stream/popup.cc",
  "protocol/session.cc", "protocol/session.h", "protocol/wire.h",
  "providers.cc", "providers.h", "linux_lock/provider.cc", "stream/provider.cc",
  "media/provider.cc", "integration/provider.cc", "accessibility/provider.cc",
  "accessibility/tree_stream.h", "accessibility/tree_stream.cc",
  "accessibility/model.h", "accessibility/model.cc",
  "accessibility/projection.h", "accessibility/projection.cc",
  "accessibility/ax_actions.h", "accessibility/ax_actions.cc",
  "accessibility/ownership.h", "accessibility/ownership.cc",
  "accessibility/accessibility_client.h", "accessibility/accessibility_client.cc",
  "//cef/include/alloy/alloy_guest_accessibility.h",
  "namespace_lock/provider.cc", "capture/provider.cc",
  "//base/process/alloy_guest_runtime.c", "//base/process/alloy_guest_runtime.h",
  "//cef/include/alloy/alloy_guest_session.h",
  "//cef/include/alloy/alloy_guest_protection.h",
  "//cef/include/alloy/alloy_guest_stream.h",
]

action("build_identity") {
  script = "make_build_identity.py"
  inputs = _implementation
  outputs = [ "$root_gen_dir/brave/alloy/guest/build_identity.h" ]
  args = [ "--out", rebase_path(outputs[0], root_build_dir) ] +
         rebase_path(inputs, root_build_dir)
}

source_set("provider_api") {
  sources = [ "providers.h", "session/extensions.h", "session/extensions.cc" ]
  public_deps = [ "protocol", "stream:resources" ]
}

source_set("foundation") {
  sources = [ "session/session.cc", "session/session.h", "session/control_queue.h", "providers.cc",
              "session/interactions.h", "session/interactions.cc" ]
  public_deps = [ "protocol", ":provider_api", "//base" ]
  deps = [ "linux_lock", "stream", "media", "integration", "accessibility",
           "namespace_lock", "capture" ]
}

group("session") {
  # Library-side sources compile in libcef_static, like CEF's native adapters.
  # Their private native-header ownership does not create a circular GN edge.
  public_deps = [ ":foundation", ":build_identity", "stream" ]
}

action("alloy_guest_host") {
  testonly = true
  script = "bootstrap/build_bootstrap.py"
  inputs = [ "bootstrap/main.c", "bootstrap/supervisor.c", "protocol/wire.h",
             "//base/process/alloy_guest_runtime.c", "//base/process/alloy_guest_runtime.h" ]
  outputs = [ "$root_out_dir/alloy_guest_host" ]
  args = [ "--root", rebase_path("//", root_build_dir),
           "--out", rebase_path(outputs[0], root_build_dir) ]
  deps = [ ":alloy_guest_engine", ":alloy_guest_sdk_consumer", ":alloy_guest_stream_consumer",
           ":alloy_guest_accessibility_consumer" ]
}

executable("alloy_guest_engine") {
  testonly = true  # CEF's libcef target is testonly.
  sources = [ "bootstrap/engine_main.cc" ]
  deps = [ "//cef:libcef", "//cef:libcef_dll_wrapper" ]
  configs += [ "//build/config/gcc:rpath_for_built_shared_libraries" ]
  use_libcxx_modules = false
}

executable("alloy_guest_sdk_consumer") {
  testonly = true
  sources = [ "session/sdk_consumer.cc" ]
  deps = [ "//cef:libcef", "//cef:libcef_dll_wrapper" ]
  configs += [ "//build/config/gcc:rpath_for_built_shared_libraries" ]
  use_libcxx_modules = false
}

executable("alloy_guest_stream_consumer") {
  testonly = true
  sources = [ "stream/sdk_consumer.cc" ]
  deps = [ "//cef:libcef", "//cef:libcef_dll_wrapper" ]
  configs += [ "//build/config/gcc:rpath_for_built_shared_libraries" ]
  use_libcxx_modules = false
}

test("alloy_guest_stream_unittests") {
  sources = [ "stream/stream_unittest.cc" ]
  deps = [ ":foundation", "stream", "stream:resources", "//base/test:run_all_unittests",
           "//base/test:test_support", "//testing/gtest" ]
}

test("alloy_guest_accessibility_unittests") {
  sources = [ "accessibility/accessibility_unittest.cc",
              "accessibility/projection_unittest.cc" ]
  deps = [ "accessibility", ":provider_api", "//base/test:run_all_unittests",
           "//base/test:test_support", "//testing/gtest", "//ui/accessibility", "//ui/gfx:test_support" ]
}

executable("alloy_guest_accessibility_consumer") {
  testonly = true
  sources = [ "accessibility/sdk_consumer.cc" ]
  deps = [ "//cef:libcef", "//cef:libcef_dll_wrapper" ]
  configs += [ "//build/config/gcc:rpath_for_built_shared_libraries" ]
  use_libcxx_modules = false
}

test("alloy_guest_session_unittests") {
  sources = [ "session/session_unittest.cc" ]
  deps = [ ":foundation", "//base/test:run_all_unittests", "//base/test:test_support", "//testing/gtest" ]
}
