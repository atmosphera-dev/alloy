import("//testing/test.gni")

source_set("mode_types") {
  sources = [ "storage_mode.h" ]
}

source_set("capabilities") {
  sources = [
    "record_capability.cc",
    "record_capability.h",
    "request_context_policy.cc",
    "request_context_policy.h",
  ]
  public_deps = [ ":mode_types", "//base", "//url" ]
  deps = [ "//net" ]
}

source_set("document_settings") {
  sources = [ "document_settings.cc", "document_settings.h" ]
  public_deps = [
    "//base",
    "//components/content_settings/core/browser",
    "//components/keyed_service/core",
  ]
}

